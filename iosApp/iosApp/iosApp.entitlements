<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Firebase Messaging: Xcode setzt beim Archivieren automatisch "production". -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Gemeinsamer Speicher mit dem Widget. Ohne ihn sieht das Widget die gewaehlte Gemeinde,
	     die Sprache und die geladenen Gebetszeiten nicht — es zeigte bisher jedem Kassel. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.igbdsandzakkassel.vaktija</string>
	</array>
</dict>
</plist>
