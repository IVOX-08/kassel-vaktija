{"ayahs": [{"n": 1, "t": "سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ", "p": 568, "tj": "سَأَلَ س[o[َا]ٓئِ[i:13912[لُۢ ب]ِعَذَا[a:13913[بٍ و]َاقِعٍ"}, {"n": 2, "t": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ", "p": 568, "tj": "لِّلْكَ[n[ـٰ]فِرِينَ لَيْسَ لَهُ[n[ۥ] دَافِعٌ"}, {"n": 3, "t": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ", "p": 568, "tj": "مِّنَ [h:321[ٱ]للَّهِ ذِى [h:13914[ٱ]لْمَعَارِ[q[ج]ِ"}, {"n": 4, "t": "تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ", "p": 568, "tj": "تَعْرُجُ [h:13915[ٱ]لْمَلَ[o[ـٰٓ]ئِكَةُ وَ[h:13916[ٱ][l[ل]رُّوحُ إِلَيْهِ فِى يَوْ[f:10625[مٍ ك]َانَ مِ[q:10626[قْ]دَارُهُ[n[ۥ] خَمْسِينَ أَلْفَ سَنَةٍ"}, {"n": 5, "t": "فَٱصْبِرْ صَبْرًۭا جَمِيلًا", "p": 568, "tj": "فَ[h:9999[ٱ]صْبِرْ صَ[q:1427[بْ][f:13917[رًا ج]َمِيلاً"}, {"n": 6, "t": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا", "p": 568, "tj": "إِ[g[نّ]َهُمْ يَرَوْنَهُ[n[ۥ] بَعِيدًا"}, {"n": 7, "t": "وَنَرَىٰهُ قَرِيبًۭا", "p": 568, "tj": "وَنَرَ[n[ٮٰ]هُ قَرِيبًا"}, {"n": 8, "t": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ", "p": 568, "tj": "يَوْمَ تَكُونُ [h:13918[ٱ][l[ل]سَّم[o[َا]ٓءُ كَ[h:8046[ٱ]لْمُهْلِ"}, {"n": 9, "t": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ", "p": 568, "tj": "وَتَكُونُ [h:13919[ٱ]لْجِبَالُ كَ[h:13920[ٱ]لْعِهْنِ"}, {"n": 10, "t": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا", "p": 568, "tj": "وَلَا يَسْــَٔلُ حَمِيمٌ حَمِيمًا"}, {"n": 11, "t": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ", "p": 569, "tj": "يُبَصَّرُونَهُمْ‌ۚ يَوَدُّ [h:13921[ٱ]لْمُ[q:13922[جْ]رِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِ[i:13923[ذِۭ ب]ِبَن[p[ِي]هِ"}, {"n": 12, "t": "وَصَٰحِبَتِهِۦ وَأَخِيهِ", "p": 569, "tj": "وَصَ[n[ـٰ]حِبَتِه[n[ِۦ] وَأَخ[p[ِي]هِ"}, {"n": 13, "t": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ", "p": 569, "tj": "وَفَصِيلَتِهِ [h:13924[ٱ]لَّتِى تُــْٔو[p[ِي]هِ"}, {"n": 14, "t": "وَمَن فِى ٱلْأَرْضِ جَمِيعًۭا ثُمَّ يُنجِيهِ", "p": 569, "tj": "وَمَ[f:3453[ن ف]ِى [h:44[ٱ]لْأَرْضِ جَمِي[f:155[عًا ث]ُ[g[مّ]َ يُ[f:13925[نج][p[ِي]هِ"}, {"n": 15, "t": "كَلَّآ ۖ إِنَّهَا لَظَىٰ", "p": 569, "tj": "كَلّ[o[َآ‌ۖ] إِ[g[نّ]َهَا لَظَىٰ"}, {"n": 16, "t": "نَزَّاعَةًۭ لِّلشَّوَىٰ", "p": 569, "tj": "نَزَّاعَ[u:13926[ةً ل]ِّلشَّوَىٰ"}, {"n": 17, "t": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ", "p": 569, "tj": "تَ[q:7934[دْ]عُو[s[اْ] مَنْ أَ[q:13927[دْ]بَرَ وَتَوَلَّىٰ"}, {"n": 18, "t": "وَجَمَعَ فَأَوْعَىٰٓ", "p": 569, "tj": "وَجَمَعَ فَأَوْعَىٰٓ"}, {"n": 19, "t": "۞ إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا", "p": 569, "tj": "۞ إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ خُلِقَ هَلُوعًا"}, {"n": 20, "t": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًۭا", "p": 569, "tj": "إِذَا مَسَّهُ [h:7875[ٱ][l[ل]شَّرُّ جَزُوعًا"}, {"n": 21, "t": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا", "p": 569, "tj": "وَإِذَا مَسَّهُ [h:13928[ٱ]لْخَيْرُ مَنُوعًا"}, {"n": 22, "t": "إِلَّا ٱلْمُصَلِّينَ", "p": 569, "tj": "إِلَّا [h:13929[ٱ]لْمُصَلّ[p[ِي]نَ"}, {"n": 23, "t": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ", "p": 569, "tj": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ د[o[َا]ٓئِم[p[ُو]نَ"}, {"n": 24, "t": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّۭ مَّعْلُومٌۭ", "p": 569, "tj": "وَ[h:9999[ٱ]لَّذِينَ ف[o[ِىٓ] أَمْو[n[َٲ]لِهِمْ حَ[a:13930[قٌّ م]َّعْل[p[ُو]مٌ"}, {"n": 25, "t": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ", "p": 569, "tj": "لِّلسّ[o[َا]ٓئِلِ وَ[h:12851[ٱ]لْمَحْر[p[ُو]مِ"}, {"n": 26, "t": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ", "p": 569, "tj": "وَ[h:9999[ٱ]لَّذِينَ يُصَدِّقُونَ بِيَوْمِ [h:13931[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 27, "t": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ", "p": 569, "tj": "وَ[h:9999[ٱ]لَّذِينَ ه[w:9232[ُم م]ِّنْ عَذَابِ رَبِّه[w:9233[ِم م]ُّشْفِق[p[ُو]نَ"}, {"n": 28, "t": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۢ", "p": 569, "tj": "إِ[g[نّ]َ عَذَابَ رَبِّهِمْ غَيْرُ مَأْم[p[ُو]نٍ"}, {"n": 29, "t": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ", "p": 569, "tj": "وَ[h:9999[ٱ]لَّذِينَ هُمْ لِفُرُوجِهِمْ حَ[n[ـٰ]فِظ[p[ُو]نَ"}, {"n": 30, "t": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ", "p": 569, "tj": "إِلَّا عَلَ[o[ىٰٓ] أَزْو[n[َٲ]جِهِمْ أَوْ مَا مَلَكَتْ أَيْمَ[n[ـٰ]نُهُمْ فَإِ[g[نّ]َهُمْ غَيْرُ مَلُوم[p[ِي]نَ"}, {"n": 31, "t": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ", "p": 569, "tj": "فَمَنِ [h:9139[ٱ][q:9140[بْ]تَغَىٰ وَر[o[َا]ٓءَ ذ[n[َٲ]لِكَ فَأُ[s[وْ]لَ[o[ـٰٓ]ئِكَ هُمُ [h:9141[ٱ]لْعَاد[p[ُو]نَ"}, {"n": 32, "t": "وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ", "p": 569, "tj": "وَ[h:9999[ٱ]لَّذِينَ هُمْ لِأَمَ[n[ـٰ]نَ[n[ـٰ]تِهِمْ وَعَهْدِهِمْ ر[n[َٲ]ع[p[ُو]نَ"}, {"n": 33, "t": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ", "p": 569, "tj": "وَ[h:9999[ٱ]لَّذِينَ ه[c:13932[ُم ب]ِشَهَ[n[ـٰ]د[n[َٲ]تِهِمْ ق[o[َا]ٓئِم[p[ُو]نَ"}, {"n": 34, "t": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ", "p": 569, "tj": "وَ[h:9999[ٱ]لَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظ[p[ُو]نَ"}, {"n": 35, "t": "أُو۟لَٰٓئِكَ فِى جَنَّٰتٍۢ مُّكْرَمُونَ", "p": 569, "tj": "أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ فِى جَ[g[نّ]َ[n[ـٰ][a:13933[تٍ م]ُّكْرَم[p[ُو]نَ"}, {"n": 36, "t": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ", "p": 569, "tj": "فَمَالِ [h:13934[ٱ]لَّذِينَ كَفَرُو[s[اْ] قِبَلَكَ مُهْطِع[p[ِي]نَ"}, {"n": 37, "t": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ", "p": 569, "tj": "عَنِ [h:7424[ٱ]لْيَمِينِ وَعَنِ [h:12807[ٱ][l[ل]شِّمَالِ عِز[p[ِي]نَ"}, {"n": 38, "t": "أَيَطْمَعُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍۢ", "p": 569, "tj": "أَيَ[q:13935[طْ]مَعُ كُلُّ [h:12916[ٱ]مْرِى[a:9346[ٍٕ م]ِّنْهُمْ أ[a:13936[َن ي]ُ[q:13937[دْ]خَلَ جَ[g[نّ]َةَ نَع[p[ِي]مٍ"}, {"n": 39, "t": "كَلَّآ ۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ", "p": 569, "tj": "كَلّ[o[َآ‌ۖ] إِ[g[نّ]َا خَلَ[q:11326[قْ]نَ[n[ـٰ]ه[w:13938[ُم م]ِّ[g[مّ]َا يَعْلَم[p[ُو]نَ"}, {"n": 40, "t": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ", "p": 570, "tj": "فَل[o[َآ] أُ[q:13287[قْ]سِمُ بِرَبِّ [h:13939[ٱ]لْمَشَ[n[ـٰ]رِقِ وَ[h:13940[ٱ]لْمَغَ[n[ـٰ]رِبِ إِ[g[نّ]َا لَقَ[n[ـٰ]دِر[p[ُو]نَ"}, {"n": 41, "t": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًۭا مِّنْهُمْ وَمَا نَحْنُ بِمَس