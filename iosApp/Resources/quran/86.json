{"ayahs": [{"n": 1, "t": "وَٱلسَّمَآءِ وَٱلطَّارِقِ", "p": 591, "tj": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ وَ[h:14418[ٱ][l[ل]طَّارِ[q[ق]ِ"}, {"n": 2, "t": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ", "p": 591, "tj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14419[ٱ][l[ل]طَّارِ[q[ق]ُ"}, {"n": 3, "t": "ٱلنَّجْمُ ٱلثَّاقِبُ", "p": 591, "tj": "ٱ[l[ل][g[نّ]َ[q:14420[جْ]مُ [h:14421[ٱ][l[ل]ثَّاقِ[q[ب]ُ"}, {"n": 4, "t": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ", "p": 591, "tj": "إِ[f:8426[ن ك]ُلُّ نَفْ[u:14422[سٍ ل]َّ[g[مّ]َا عَلَيْهَا حَافِظٌ"}, {"n": 5, "t": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ", "p": 591, "tj": "فَلْيَ[f:14313[نظ]ُرِ [h:14314[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مِ[g[مّ]َ خُلِ[q[ق]َ"}, {"n": 6, "t": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ", "p": 591, "tj": "خُلِقَ م[a:840[ِن م]ّ[o[َا]ٓ[f:14423[ءٍ د]َافِ[q[ق]ٍ"}, {"n": 7, "t": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ", "p": 591, "tj": "يَخْرُجُ م[i:4612[ِنۢ ب]َيْنِ [h:14424[ٱ][l[ل]صُّلْبِ وَ[h:14425[ٱ][l[ل]تَّر[o[َا]ٓئِ[q[ب]ِ"}, {"n": 8, "t": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ", "p": 591, "tj": "إِ[g[نّ]َهُ[n[ۥ] عَلَىٰ رَ[q:14426[جْ]عِه[n[ِۦ] لَقَادِرٌ"}, {"n": 9, "t": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ", "p": 591, "tj": "يَوْمَ تُ[q:14427[بْ]لَى [h:14428[ٱ][l[ل]سَّر[o[َا]ٓئِرُ"}, {"n": 10, "t": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ", "p": 591, "tj": "فَمَا لَهُ[n[ۥ] مِ[f:5395[ن ق]ُوَّ[a:14429[ةٍ و]َلَا نَاصِرٍ"}, {"n": 11, "t": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ", "p": 591, "tj": "وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ ذَاتِ [h:14430[ٱ][l[ل]رَّ[q:14431[جْ]عِ"}, {"n": 12, "t": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ", "p": 591, "tj": "وَ[h:9999[ٱ]لْأَرْضِ ذَاتِ [h:14432[ٱ][l[ل]صَّ[q:14433[دْ]عِ"}, {"n": 13, "t": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ", "p": 591, "tj": "إِ[g[نّ]َهُ[n[ۥ] لَقَوْ[f:14434[لٌ ف]َصْلٌ"}, {"n": 14, "t": "وَمَا هُوَ بِٱلْهَزْلِ", "p": 591, "tj": "وَمَا هُوَ بِ[h:14435[ٱ]لْهَزْلِ"}, {"n": 15, "t": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا", "p": 591, "tj": "إِ[g[نّ]َهُمْ يَكِيدُونَ كَيْدًا"}, {"n": 16, "t": "وَأَكِيدُ كَيْدًۭا", "p": 591, "tj": "وَأَكِيدُ كَيْدًا"}, {"n": 17, "t": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا", "p": 591, "tj": "فَمَهِّلِ [h:14436[ٱ]لْكَ[n[ـٰ]فِرِينَ أَمْهِلْهُمْ رُوَيْدَۢا"}]}