{"ayahs": [{"n": 1, "t": "وَٱلصَّٰٓفَّٰتِ صَفًّۭا", "p": 446, "tj": "وَ[h:9999[ٱ][l[ل]صَّ[m[ـٰٓ]فَّ[n[ـٰ]تِ صَفًّا"}, {"n": 2, "t": "فَٱلزَّٰجِرَٰتِ زَجْرًۭا", "p": 446, "tj": "فَ[h:9999[ٱ][l[ل]زّ[n[َٲ]جِر[n[َٲ]تِ زَ[q:11312[جْ]رًا"}, {"n": 3, "t": "فَٱلتَّٰلِيَٰتِ ذِكْرًا", "p": 446, "tj": "فَ[h:9999[ٱ][l[ل]تَّ[n[ـٰ]لِيَ[n[ـٰ]تِ ذِكْرًا"}, {"n": 4, "t": "إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌۭ", "p": 446, "tj": "إِ[g[نّ]َ إِلَ[n[ـٰ]هَكُمْ لَو[n[َٲ]حِ[q[د]ٌ"}, {"n": 5, "t": "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ", "p": 446, "tj": "رَّبُّ [h:6926[ٱ][l[ل]سَّمَ[n[ـٰ]و[n[َٲ]تِ وَ[h:177[ٱ]لْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ [h:11313[ٱ]لْمَشَ[n[ـٰ]رِ[q[ق]ِ"}, {"n": 6, "t": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ", "p": 446, "tj": "إِ[g[نّ]َا زَيَّ[g[نّ]َا [h:11314[ٱ][l[ل]سَّم[o[َا]ٓءَ [h:11315[ٱ][l[ل]دُّنْيَا بِزِينَةٍ [h:11316[ٱ]لْكَوَاكِ[q[ب]ِ"}, {"n": 7, "t": "وَحِفْظًۭا مِّن كُلِّ شَيْطَٰنٍۢ مَّارِدٍۢ", "p": 446, "tj": "وَحِفْ[a:11317[ظًا م]ِّ[f:843[ن ك]ُلِّ شَيْطَ[n[ـٰ][a:11318[نٍ م]َّارِ[q[د]ٍ"}, {"n": 8, "t": "لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍۢ", "p": 446, "tj": "لَّا يَسَّ[g[مّ]َعُونَ إِلَى [h:1384[ٱ]لْمَلَإِ [h:11319[ٱ]لْأَعْلَىٰ وَيُ[q:11320[قْ]ذَفُونَ مِ[f:843[ن ك]ُلِّ جَانِ[q[ب]ٍ"}, {"n": 9, "t": "دُحُورًۭا ۖ وَلَهُمْ عَذَابٌۭ وَاصِبٌ", "p": 446, "tj": "دُحُو[a:11321[رًا‌ۖ و]َلَهُمْ عَذَا[a:11322[بٌ و]َاصِ[q[ب]ٌ"}, {"n": 10, "t": "إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌۭ ثَاقِبٌۭ", "p": 446, "tj": "إِلَّا مَنْ خَطِفَ [h:11323[ٱ]لْخَ[q:11324[طْ]فَةَ فَأَتْبَعَهُ[n[ۥ] شِهَا[f:11325[بٌ ث]َاقِ[q[ب]ٌ"}, {"n": 11, "t": "فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَٰهُم مِّن طِينٍۢ لَّازِبٍۭ", "p": 446, "tj": "فَ[h:9999[ٱ]سْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أ[w:3110[َم م]َّنْ خَلَ[q:5159[قْ]ن[o[َآ‌ۚ] إِ[g[نّ]َا خَلَ[q:11326[قْ]نَ[n[ـٰ]ه[w:11327[ُم م]ِّ[f:3917[ن ط]ِي[u:11328[نٍ ل]َّازِ[q[ب]ِۭ"}, {"n": 12, "t": "بَلْ عَجِبْتَ وَيَسْخَرُونَ", "p": 446, "tj": "بَلْ عَجِ[q:11329[بْ]تَ وَيَسْخَر[p[ُو]نَ"}, {"n": 13, "t": "وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ", "p": 446, "tj": "وَإِذَا ذُكِّرُو[s[اْ] لَا يَذْكُر[p[ُو]نَ"}, {"n": 14, "t": "وَإِذَا رَأَوْا۟ ءَايَةًۭ يَسْتَسْخِرُونَ", "p": 446, "tj": "وَإِذَا رَأَوْ[s[اْ] ءَايَ[a:11330[ةً ي]َسْتَسْخِر[p[ُو]نَ"}, {"n": 15, "t": "وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ مُّبِينٌ", "p": 446, "tj": "وَقَال[o[ُوٓ][s[اْ] إِنْ هَ[n[ـٰ]ذ[o[َآ] إِلَّا سِحْ[a:3879[رٌ م]ُّب[p[ِي]نٌ"}, {"n": 16, "t": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ", "p": 446, "tj": "أَءِذَا مِتْنَا وَكُ[g[نّ]َا تُرَا[a:9207[بًا و]َعِظَ[n[ـٰ]مًا أَءِ[g[نّ]َا لَمَ[q:7784[بْ]عُوث[p[ُو]نَ"}, {"n": 17, "t": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ", "p": 446, "tj": "أَوَءَاب[o[َا]ٓؤُنَا [h:11331[ٱ]لْأَوَّل[p[ُو]نَ"}, {"n": 18, "t": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ", "p": 446, "tj": "قُلْ نَعَمْ وَأَ[f:98[نت]ُمْ د[n[َٲ]خِر[p[ُو]نَ"}, {"n": 19, "t": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ فَإِذَا هُمْ يَنظُرُونَ", "p": 446, "tj": "فَإِ[g[نّ]َمَا هِىَ زَ[q:11332[جْ]رَ[a:11333[ةٌ و][n[َٲ]حِدَ[f:11334[ةٌ ف]َإِذَا هُمْ يَ[f:1141[نظ]ُر[p[ُو]نَ"}, {"n": 20, "t": "وَقَالُوا۟ يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ", "p": 446, "tj": "وَقَالُو[s[اْ] يَ[n[ـٰ]وَيْلَنَا هَ[n[ـٰ]ذَا يَوْمُ [h:11335[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 21, "t": "هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ", "p": 446, "tj": "هَ[n[ـٰ]ذَا يَوْمُ [h:11336[ٱ]لْفَصْلِ [h:11337[ٱ]لَّذِى كُ[f:100[نت][c:6084[ُم ب]ِه[n[ِۦ] تُكَذِّب[p[ُو]نَ"}, {"n": 22, "t": "۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ", "p": 446, "tj": "۞ ٱحْشُرُو[s[اْ] [h:11338[ٱ]لَّذِينَ ظَلَمُو[s[اْ] وَأَزْو[n[َٲ]جَهُمْ وَمَا كَانُو[s[اْ] يَعْبُد[p[ُو]نَ"}, {"n": 23, "t": "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ", "p": 446, "tj": "مِ[f:107[ن د]ُونِ [h:108[ٱ]للَّهِ فَ[h:11339[ٱ]هْدُوهُمْ إِلَىٰ صِر[n[َٲ]طِ [h:11340[ٱ]لْجَح[p[ِي]مِ"}, {"n": 24, "t": "وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ", "p": 446, "t