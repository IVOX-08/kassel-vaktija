{"ayahs": [{"n": 1, "t": "أَلْهَىٰكُمُ ٱلتَّكَاثُرُ", "p": 600}, {"n": 2, "t": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ", "p": 600}, {"n": 3, "t": "كَلَّا سَوْفَ تَعْلَمُونَ", "p": 600}, {"n": 4, "t": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ", "p": 600}, {"n": 5, "t": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ", "p": 600}, {"n": 6, "t": "لَتَرَوُنَّ ٱلْجَحِيمَ", "p": 600}, {"n": 7, "t": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ", "p": 600}, {"n": 8, "t": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ", "p": 600}]}