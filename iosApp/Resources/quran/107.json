{"ayahs": [{"n": 1, "t": "أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ", "p": 602, "tj": "أَرَءَيْتَ [h:14568[ٱ]لَّذِى يُكَذِّبُ بِ[h:14361[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 2, "t": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ", "p": 602, "tj": "فَذ[n[َٲ]لِكَ [h:14654[ٱ]لَّذِى يَدُعُّ [h:14655[ٱ]لْيَت[p[ِي]مَ"}, {"n": 3, "t": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "p": 602, "tj": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ [h:13901[ٱ]لْمِسْك[p[ِي]نِ"}, {"n": 4, "t": "فَوَيْلٌۭ لِّلْمُصَلِّينَ", "p": 602, "tj": "فَوَيْ[u:14656[لٌ ل]ِّلْمُصَلّ[p[ِي]نَ"}, {"n": 5, "t": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "p": 602, "tj": "ٱلَّذِينَ هُمْ عَ[f:14657[ن ص]َلَاتِهِمْ سَاه[p[ُو]نَ"}, {"n": 6, "t": "ٱلَّذِينَ هُمْ يُرَآءُونَ", "p": 602, "tj": "ٱلَّذِينَ هُمْ يُر[o[َا]ٓء[p[ُو]نَ"}, {"n": 7, "t": "وَيَمْنَعُونَ ٱلْمَاعُونَ", "p": 602, "tj": "وَيَمْنَعُونَ [h:14658[ٱ]لْمَاع[p[ُو]نَ"}]}