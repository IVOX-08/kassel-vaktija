{"ayahs": [{"n": 1, "t": "نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ", "p": 564, "tj": "[m[نٓ]‌ۚ وَ[h:13811[ٱ]لْقَلَمِ وَمَا يَسْطُر[p[ُو]نَ"}, {"n": 2, "t": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍۢ", "p": 564, "tj": "م[o[َآ] أَ[f:169[نت]َ بِنِعْمَةِ رَبِّكَ بِمَ[q:13812[جْ]ن[p[ُو]نٍ"}, {"n": 3, "t": "وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍۢ", "p": 564, "tj": "وَإِ[g[نّ]َ لَكَ لَأَ[q:4918[جْ]رًا غَيْرَ مَمْن[p[ُو]نٍ"}, {"n": 4, "t": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍۢ", "p": 564, "tj": "وَإِ[g[نّ]َكَ لَعَلَىٰ خُلُقٍ عَظ[p[ِي]مٍ"}, {"n": 5, "t": "فَسَتُبْصِرُ وَيُبْصِرُونَ", "p": 564, "tj": "فَسَتُ[q:13813[بْ]صِرُ وَيُ[q:13814[بْ]صِر[p[ُو]نَ"}, {"n": 6, "t": "بِأَييِّكُمُ ٱلْمَفْتُونُ", "p": 564, "tj": "بِأَييِّكُمُ [h:13815[ٱ]لْمَفْت[p[ُو]نُ"}, {"n": 7, "t": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ", "p": 564, "tj": "إِ[g[نّ]َ رَبَّكَ هُوَ أَعْلَمُ بِمَ[f:7639[ن ض]َلَّ عَ[f:4361[ن س]َبِيلِه[n[ِۦ] وَهُوَ أَعْلَمُ بِ[h:4362[ٱ]لْمُهْتَد[p[ِي]نَ"}, {"n": 8, "t": "فَلَا تُطِعِ ٱلْمُكَذِّبِينَ", "p": 564, "tj": "فَلَا تُطِعِ [h:13816[ٱ]لْمُكَذِّب[p[ِي]نَ"}, {"n": 9, "t": "وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ", "p": 564, "tj": "وَدُّو[s[اْ] لَوْ تُ[q:13817[دْ]هِنُ فَيُ[q:13818[دْ]هِن[p[ُو]نَ"}, {"n": 10, "t": "وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ", "p": 564, "tj": "وَلَا تُطِعْ كُلَّ حَلَّا[a:13819[فٍ م]َّه[p[ِي]نٍ"}, {"n": 11, "t": "هَمَّازٍۢ مَّشَّآءٍۭ بِنَمِيمٍۢ", "p": 564, "tj": "هَ[g[مّ]َا[a:13820[زٍ م]َّشّ[o[َا]ٓ[i:13821[ءِۭ ب]ِنَم[p[ِي]مٍ"}, {"n": 12, "t": "مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ", "p": 564, "tj": "مَّ[g[نّ]َا[u:12814[عٍ ل]ِّلْخَيْرِ مُعْتَدٍ أَث[p[ِي]مٍ"}, {"n": 13, "t": "عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ", "p": 564, "tj": "عُتُل[i:13822[ِّۭ ب]َعْدَ ذ[n[َٲ]لِكَ زَن[p[ِي]مٍ"}, {"n": 14, "t": "أَن كَانَ ذَا مَالٍۢ وَبَنِينَ", "p": 564, "tj": "أَ[f:13823[ن ك]َانَ ذَا مَا[a:9231[لٍ و]َبَن[p[ِي]نَ"}, {"n": 15, "t": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ", "p": 564, "tj": "إِذَا تُت