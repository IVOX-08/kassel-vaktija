{"ayahs": [{"n": 1, "t": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ", "p": 601, "tj": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَ[n[ـٰ]بِ [h:14643[ٱ]لْف[p[ِي]لِ"}, {"n": 2, "t": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ", "p": 601, "tj": "أَلَمْ يَ[q:4397[جْ]عَلْ كَيْدَهُمْ فِى تَضْل[p[ِي]لٍ"}, {"n": 3, "t": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ", "p": 601, "tj": "وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَاب[p[ِي]لَ"}, {"n": 4, "t": "تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ", "p": 601, "tj": "تَرْمِيه[c:14644[ِم ب]ِحِجَارَ[a:14645[ةٍ م]ِّ[f:6445[ن س]ِجّ[p[ِي]لٍ"}, {"n": 5, "t": "فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ", "p": 601, "tj": "فَجَعَلَهُمْ كَعَصْ[a:14646[فٍ م]َّأْك[p[ُو]لِۭ"}]}