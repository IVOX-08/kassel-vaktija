{"ayahs": [{"n": 1, "t": "لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ", "p": 577, "tj": "ل[o[َآ] أُ[q:13287[قْ]سِمُ بِيَوْمِ [h:14115[ٱ]لْقِيَ[n[ـٰ]مَةِ"}, {"n": 2, "t": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ", "p": 577, "tj": "وَل[o[َآ] أُ[q:13287[قْ]سِمُ بِ[h:3575[ٱ][l[ل][g[نّ]َفْسِ [h:14116[ٱ][l[ل]لَّوَّامَةِ"}, {"n": 3, "t": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ", "p": 577, "tj": "أَيَحْسَبُ [h:14117[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ أَلّ[a:14118[َن ن]َّ[q:14119[جْ]مَعَ عِظَامَهُۥ"}, {"n": 4, "t": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ", "p": 577, "tj": "بَلَىٰ قَ[n[ـٰ]دِرِينَ عَلَ[o[ىٰٓ] أ[a:14120[َن ن]ُّسَوِّىَ بَنَانَهُۥ"}, {"n": 5, "t": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ", "p": 577, "tj": "بَلْ يُرِيدُ [h:14121[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ لِيَفْجُرَ أَمَامَهُۥ"}, {"n": 6, "t": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ", "p": 577, "tj": "يَسْــَٔلُ أَيَّانَ يَوْمُ [h:14122[ٱ]لْقِيَ[n[ـٰ]مَةِ"}, {"n": 7, "t": "فَإِذَا بَرِقَ ٱلْبَصَرُ", "p": 577, "tj": "فَإِذَا بَرِقَ [h:14123[ٱ]لْبَصَرُ"}, {"n": 8, "t": "وَخَسَفَ ٱلْقَمَرُ", "p": 577, "tj": "وَخَسَفَ [h:14124[ٱ]لْقَمَرُ"}, {"n": 9, "t": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ", "p": 577, "tj": "وَجُمِعَ [h:14125[ٱ][l[ل]شَّمْسُ وَ[h:8956[ٱ]لْقَمَرُ"}, {"n": 10, "t": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ", "p": 577, "tj": "يَقُولُ [h:14126[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ يَوْمَئِذٍ أَيْنَ [h:14127[ٱ]لْمَفَرُّ"}, {"n": 11, "t": "كَلَّا لَا وَزَرَ", "p": 577, "tj": "كَلَّا لَا وَزَرَ"}, {"n": 12, "t": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ", "p": 577, "tj": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ [h:14128[ٱ]لْمُسْتَقَرُّ"}, {"n": 13, "t": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ", "p": 577, "tj": "يُنَبَّؤُ[s[اْ] [h:14129[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ يَوْمَئِ[i:14130[ذِۭ ب]ِمَا قَدَّمَ وَأَخَّرَ"}, {"n": 14, "t": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ", "p": 577, "tj": "بَلِ [h:14131[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ عَلَىٰ نَفْسِه[n[ِۦ] بَصِيرَةٌ"}, {"n": 15, "t": "وَلَوْ أَلْ