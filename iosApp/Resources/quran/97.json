{"ayahs": [{"n": 1, "t": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ", "p": 598, "tj": "إِ[g[نّ][o[َآ] أَ[f:4236[نز]َلْنَ[n[ـٰ]هُ فِى لَيْلَةِ [h:14580[ٱ]لْقَ[q:14581[دْ]رِ"}, {"n": 2, "t": "وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ", "p": 598, "tj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا لَيْلَةُ [h:14582[ٱ]لْقَ[q:14581[دْ]رِ"}, {"n": 3, "t": "لَيْلَةُ ٱلْقَدْرِ خَيْرٌۭ مِّنْ أَلْفِ شَهْرٍۢ", "p": 598, "tj": "لَيْلَةُ [h:14582[ٱ]لْقَ[q:14581[دْ]رِ خَيْ[a:1231[رٌ م]ِّنْ أَلْفِ شَهْرٍ"}, {"n": 4, "t": "تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍۢ", "p": 598, "tj": "تَنَزَّلُ [h:14583[ٱ]لْمَلَ[o[ـٰٓ]ئِكَةُ وَ[h:13916[ٱ][l[ل]رُّوحُ فِيهَا بِإِذْنِ رَبِّه[w:14584[ِم م]ِّ[f:843[ن ك]ُلِّ أَمْرٍ"}, {"n": 5, "t": "سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ", "p": 598, "tj": "سَلَ[n[ـٰ]مٌ هِىَ حَتَّىٰ مَ[q:14585[طْ]لَعِ [h:14586[ٱ]لْفَ[q:996[جْ]رِ"}]}