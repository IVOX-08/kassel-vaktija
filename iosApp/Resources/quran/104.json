{"ayahs": [{"n": 1, "t": "وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ", "p": 601, "tj": "وَيْ[u:12392[لٌ ل]ِّكُلِّ هُمَزَ[u:14633[ةٍ ل]ُّمَزَةٍ"}, {"n": 2, "t": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ", "p": 601, "tj": "ٱلَّذِى جَمَعَ مَال[a:14634[اً و]َعَدَّدَهُۥ"}, {"n": 3, "t": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ", "p": 601, "tj": "يَحْسَبُ أَ[g[نّ]َ مَالَهُ[o[ۥٓ] أَخْلَدَهُۥ"}, {"n": 4, "t": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ", "p": 601, "tj": "كَلَّا‌ۖ لَيُ[i:14635[نۢب]َذَ[g[نّ]َ فِى [h:14636[ٱ]لْحُطَمَةِ"}, {"n": 5, "t": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ", "p": 601, "tj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14637[ٱ]لْحُطَمَةُ"}, {"n": 6, "t": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ", "p": 601, "tj": "نَارُ [h:14638[ٱ]للَّهِ [h:14639[ٱ]لْمُوقَدَةُ"}, {"n": 7, "t": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ", "p": 601, "tj": "ٱلَّتِى تَطَّلِعُ عَلَى [h:14640[ٱ]لْأَفْــِٔدَةِ"}, {"n": 8, "t": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ", "p": 601, "tj": "إِ[g[نّ]َهَا عَلَيْه[w:14641[ِم م]ُّؤْصَدَةٌ"}, {"n": 9, "t": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ", "p": 601, "tj": "فِى عَمَ[a:14642[دٍ م]ُّمَدَّدَةِۭ"}]}