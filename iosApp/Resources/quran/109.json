{"ayahs": [{"n": 1, "t": "قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ", "p": 603, "tj": "قُلْ يَ[o[ـٰٓ]أَيُّهَا [h:14663[ٱ]لْكَ[n[ـٰ]فِر[p[ُو]نَ"}, {"n": 2, "t": "لَآ أَعْبُدُ مَا تَعْبُدُونَ", "p": 603, "tj": "ل[o[َآ] أَعْبُدُ مَا تَعْبُد[p[ُو]نَ"}, {"n": 3, "t": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ", "p": 603, "tj": "وَل[o[َآ] أَ[f:428[نت]ُمْ عَ[n[ـٰ]بِدُونَ م[o[َآ] أَعْبُ[q[د]ُ"}, {"n": 4, "t": "وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ", "p": 603, "tj": "وَل[o[َآ] أَنَا۟ عَابِ[a:14664[دٌ م]َّا عَبَ[d:14665[د]تُّمْ"}, {"n": 5, "t": "وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ", "p": 603, "tj": "وَل[o[َآ] أَ[f:428[نت]ُمْ عَ[n[ـٰ]بِدُونَ م[o[َآ] أَعْبُ[q[د]ُ"}, {"n": 6, "t": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ", "p": 603, "tj": "لَكُمْ دِينُكُمْ وَلِىَ د[p[ِي]نِ"}]}