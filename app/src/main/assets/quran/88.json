{"ayahs": [{"n": 1, "t": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ"}, {"n": 2, "t": "وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ"}, {"n": 3, "t": "عَامِلَةٞ نَّاصِبَةٞ"}, {"n": 4, "t": "تَصۡلَىٰ نَارًا حَامِيَةٗ"}, {"n": 5, "t": "تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ"}, {"n": 6, "t": "لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ"}, {"n": 7, "t": "لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ"}, {"n": 8, "t": "وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ"}, {"n": 9, "t": "لِّسَعۡيِهَا رَاضِيَةٞ"}, {"n": 10, "t": "فِي جَنَّةٍ عَالِيَةٖ"}, {"n": 11, "t": "لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ"}, {"n": 12, "t": "فِيهَا عَيۡنٞ جَارِيَةٞ"}, {"n": 13, "t": "فِيهَا سُرُرٞ مَّرۡفُوعَةٞ"}, {"n": 14, "t": "وَأَكۡوَابٞ مَّوۡضُوعَةٞ"}, {"n": 15, "t": "وَنَمَارِقُ مَصۡفُوفَةٞ"}, {"n": 16, "t": "وَزَرَابِيُّ مَبۡثُوثَةٌ"}, {"n": 17, "t": "أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ"}, {"n": 18, "t": "وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ"}, {"n": 19, "t": "وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ"}, {"n": 20, "t": "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ"}, {"n": 21, "t": "فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ"}, {"n": 22, "t": "لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ"}, {"n": 23, "t": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"}, {"n": 24, "t": "فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ"}, {"n": 25, "t": "إِنَّ إِلَيۡنَآ إِيَابَهُمۡ"}, {"n": 26, "t": "ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم"}]}