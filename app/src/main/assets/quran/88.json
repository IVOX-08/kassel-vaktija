{"ayahs": [{"n": 1, "t": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ", "p": 592, "tj": "هَلْ أَتَ[n[ـٰ]كَ حَدِيثُ [h:14451[ٱ]لْغَ[n[ـٰ]شِيَةِ"}, {"n": 2, "t": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ", "p": 592, "tj": "وُجُو[a:14135[هٌ ي]َوْمَئِذٍ خَ[n[ـٰ]شِعَةٌ"}, {"n": 3, "t": "عَامِلَةٌۭ نَّاصِبَةٌۭ", "p": 592, "tj": "عَامِلَ[a:14452[ةٌ ن]َّاصِبَةٌ"}, {"n": 4, "t": "تَصْلَىٰ نَارًا حَامِيَةًۭ", "p": 592, "tj": "تَصْلَىٰ نَارًا حَامِيَةً"}, {"n": 5, "t": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ", "p": 592, "tj": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"}, {"n": 6, "t": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ", "p": 592, "tj": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِ[f:14453[ن ض]َر[p[ِي]عٍ"}, {"n": 7, "t": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ", "p": 592, "tj": "لَّا يُسْمِنُ وَلَا يُغْنِى مِ[f:14454[ن ج][p[ُو]عٍ"}, {"n": 8, "t": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ", "p": 592, "tj": "وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14455[ذٍ ن]َّاعِمَةٌ"}, {"n": 9, "t": "لِّسَعْيِهَا رَاضِيَةٌۭ", "p": 592, "tj": "لِّسَعْيِهَا رَاضِيَةٌ"}, {"n": 10, "t": "فِى جَنَّةٍ عَالِيَةٍۢ", "p": 592, "tj": "فِى جَ[g[نّ]َةٍ عَالِيَةٍ"}, {"n": 11, "t": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ", "p": 592, "tj": "لَّا تَسْمَعُ فِيهَا لَ[n[ـٰ]غِيَةً"}, {"n": 12, "t": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ", "p": 592, "tj": "فِيهَا عَيْ[f:14456[نٌ ج]َارِيَةٌ"}, {"n": 13, "t": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ", "p": 592, "tj": "فِيهَا سُرُ[a:14457[رٌ م]َّرْفُوعَةٌ"}, {"n": 14, "t": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ", "p": 592, "tj": "وَأَكْوَا[a:14458[بٌ م]َّوْضُوعَةٌ"}, {"n": 15, "t": "وَنَمَارِقُ مَصْفُوفَةٌۭ", "p": 592, "tj": "وَنَمَارِقُ مَصْفُوفَةٌ"}, {"n": 16, "t": "وَزَرَابِىُّ مَبْثُوثَةٌ", "p": 592, "tj": "وَزَرَابِىُّ مَ[q:14459[بْ]ثُوثَةٌ"}, {"n": 17, "t": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ", "p": 592, "tj": "أَفَلَا يَ[f:1141[نظ]ُرُونَ إِلَى [h:14460[ٱ]لْإِبِلِ كَيْفَ خُلِقَتْ"}, {"n": 18, "t": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ", "p": 592, "tj": "وَإِلَى [h:14461[ٱ][l[ل]سَّم[o[َا]ٓءِ كَيْفَ رُفِعَتْ"}, {"n": 19, "t": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ", "p": 592, "tj": "وَإِلَى [h:14462[ٱ]لْجِبَالِ كَيْفَ نُصِبَتْ"}, {"n": 20, "t": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ", "p": 592, "tj": "وَإِلَى [h:14463[ٱ]لْأَرْضِ كَيْفَ سُطِحَتْ"}, {"n": 21, "t": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ", "p": 592, "tj": "فَذَكِّرْ إِ[g[نّ]َم[o[َآ] أَ[f:169[نت]َ مُذَكِّرٌ"}, {"n": 22, "t": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ", "p": 592, "tj": "لَّسْتَ عَلَيْه[c:14464[ِم ب]ِمُصَيْطِرٍ"}, {"n": 23, "t": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ", "p": 592, "tj": "إِلَّا مَ[f:12995[ن ت]َوَلَّىٰ وَكَفَرَ"}, {"n": 24, "t": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ", "p": 592, "tj": "فَيُعَذِّبُهُ [h:14465[ٱ]للَّهُ [h:14466[ٱ]لْعَذَابَ [h:14467[ٱ]لْأَكْبَرَ"}, {"n": 25, "t": "إِنَّ إِلَيْنَآ إِيَابَهُمْ", "p": 592, "tj": "إِ[g[نّ]َ إِلَيْن[o[َآ] إِيَابَهُمْ"}, {"n": 26, "t": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم", "p": 592, "tj": "ثُ[g[مّ]َ إِ[g[نّ]َ عَلَيْنَا حِسَابَهُم"}]}