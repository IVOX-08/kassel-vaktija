{"ayahs": [{"n": 1, "t": "إِذَا ٱلشَّمۡسُ كُوِّرَتۡ"}, {"n": 2, "t": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ"}, {"n": 3, "t": "وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ"}, {"n": 4, "t": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ"}, {"n": 5, "t": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ"}, {"n": 6, "t": "وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ"}, {"n": 7, "t": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ"}, {"n": 8, "t": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ"}, {"n": 9, "t": "بِأَيِّ ذَنۢبٖ قُتِلَتۡ"}, {"n": 10, "t": "وَإِذَا ٱلصُّحُفُ نُشِرَتۡ"}, {"n": 11, "t": "وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ"}, {"n": 12, "t": "وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ"}, {"n": 13, "t": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ"}, {"n": 14, "t": "عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ"}, {"n": 15, "t": "فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ"}, {"n": 16, "t": "ٱلۡجَوَارِ ٱلۡكُنَّسِ"}, {"n": 17, "t": "وَٱلَّيۡلِ إِذَا عَسۡعَسَ"}, {"n": 18, "t": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ"}, {"n": 19, "t": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ"}, {"n": 20, "t": "ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ"}, {"n": 21, "t": "مُّطَاعٖ ثَمَّ أَمِينٖ"}, {"n": 22, "t": "وَمَا صَاحِبُكُم بِمَجۡنُونٖ"}, {"n": 23, "t": "وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ"}, {"n": 24, "t": "وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ"}, {"n": 25, "t": "وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ"}, {"n": 26, "t": "فَأَيۡنَ تَذۡهَبُونَ"}, {"n": 27, "t": "إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ"}, {"n": 28, "t": "لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ"}, {"n": 29, "t": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ"}]}