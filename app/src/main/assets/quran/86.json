{"ayahs": [{"n": 1, "t": "وَٱلسَّمَآءِ وَٱلطَّارِقِ"}, {"n": 2, "t": "وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ"}, {"n": 3, "t": "ٱلنَّجۡمُ ٱلثَّاقِبُ"}, {"n": 4, "t": "إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ"}, {"n": 5, "t": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ"}, {"n": 6, "t": "خُلِقَ مِن مَّآءٖ دَافِقٖ"}, {"n": 7, "t": "يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ"}, {"n": 8, "t": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ"}, {"n": 9, "t": "يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ"}, {"n": 10, "t": "فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ"}, {"n": 11, "t": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ"}, {"n": 12, "t": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ"}, {"n": 13, "t": "إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ"}, {"n": 14, "t": "وَمَا هُوَ بِٱلۡهَزۡلِ"}, {"n": 15, "t": "إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا"}, {"n": 16, "t": "وَأَكِيدُ كَيۡدٗا"}, {"n": 17, "t": "فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا"}]}