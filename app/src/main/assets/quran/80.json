{"ayahs": [{"n": 1, "t": "عَبَسَ وَتَوَلَّىٰٓ"}, {"n": 2, "t": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ"}, {"n": 3, "t": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"}, {"n": 4, "t": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ"}, {"n": 5, "t": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ"}, {"n": 6, "t": "فَأَنتَ لَهُۥ تَصَدَّىٰ"}, {"n": 7, "t": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ"}, {"n": 8, "t": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ"}, {"n": 9, "t": "وَهُوَ يَخۡشَىٰ"}, {"n": 10, "t": "فَأَنتَ عَنۡهُ تَلَهَّىٰ"}, {"n": 11, "t": "كَلَّآ إِنَّهَا تَذۡكِرَةٞ"}, {"n": 12, "t": "فَمَن شَآءَ ذَكَرَهُۥ"}, {"n": 13, "t": "فِي صُحُفٖ مُّكَرَّمَةٖ"}, {"n": 14, "t": "مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ"}, {"n": 15, "t": "بِأَيۡدِي سَفَرَةٖ"}, {"n": 16, "t": "كِرَامِۭ بَرَرَةٖ"}, {"n": 17, "t": "قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ"}, {"n": 18, "t": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ"}, {"n": 19, "t": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"}, {"n": 20, "t": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"}, {"n": 21, "t": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ"}, {"n": 22, "t": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"}, {"n": 23, "t": "كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ"}, {"n": 24, "t": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ"}, {"n": 25, "t": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا"}, {"n": 26, "t": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا"}, {"n": 27, "t": "فَأَنۢبَتۡنَا فِيهَا حَبّٗا"}, {"n": 28, "t": "وَعِنَبٗا وَقَضۡبٗا"}, {"n": 29, "t": "وَزَيۡتُونٗا وَنَخۡلٗا"}, {"n": 30, "t": "وَحَدَآئِقَ غُلۡبٗا"}, {"n": 31, "t": "وَفَٰكِهَةٗ وَأَبّٗا"}, {"n": 32, "t": "مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ"}, {"n": 33, "t": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"}, {"n": 34, "t": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ"}, {"n": 35, "t": "وَأُمِّهِۦ وَأَبِيهِ"}, {"n": 36, "t": "وَصَٰحِبَتِهِۦ وَبَنِيهِ"}, {"n": 37, "t": "لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ"}, {"n": 38, "t": "وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ"}, {"n": 39, "t": "ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ"}, {"n": 40, "t": "وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ"}, {"n": 41, "t": "تَرۡهَقُهَا قَتَرَةٌ"}, {"n": 42, "t": "أُوْلَـٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ"}]}