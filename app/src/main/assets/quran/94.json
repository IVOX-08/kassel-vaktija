{"ayahs": [{"n": 1, "t": "أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ"}, {"n": 2, "t": "وَوَضَعۡنَا عَنكَ وِزۡرَكَ"}, {"n": 3, "t": "ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ"}, {"n": 4, "t": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ"}, {"n": 5, "t": "فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا"}, {"n": 6, "t": "إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا"}, {"n": 7, "t": "فَإِذَا فَرَغۡتَ فَٱنصَبۡ"}, {"n": 8, "t": "وَإِلَىٰ رَبِّكَ فَٱرۡغَب"}]}