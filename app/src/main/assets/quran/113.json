{"ayahs": [{"n": 1, "t": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ", "p": 604, "tj": "قُلْ أَعُوذُ بِرَبِّ [h:14678[ٱ]لْفَلَ[q[ق]ِ"}, {"n": 2, "t": "مِن شَرِّ مَا خَلَقَ", "p": 604, "tj": "مِ[f:14679[ن ش]َرِّ مَا خَلَ[q[ق]َ"}, {"n": 3, "t": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ", "p": 604, "tj": "وَمِ[f:14680[ن ش]َرِّ غَاسِقٍ إِذَا وَقَ[q[ب]َ"}, {"n": 4, "t": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ", "p": 604, "tj": "وَمِ[f:14680[ن ش]َرِّ [h:14681[ٱ][l[ل][g[نّ]َفَّ[n[ـٰ]ثَ[n[ـٰ]تِ فِى [h:14682[ٱ]لْعُقَ[q[د]ِ"}, {"n": 5, "t": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ", "p": 604, "tj": "وَمِ[f:14680[ن ش]َرِّ حَاسِدٍ إِذَا حَسَ[q[د]َ"}]}