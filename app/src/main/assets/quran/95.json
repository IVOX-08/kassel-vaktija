{"ayahs": [{"n": 1, "t": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ", "p": 597, "tj": "وَ[h:9999[ٱ][l[ل]تِّينِ وَ[h:14553[ٱ][l[ل]زَّيْت[p[ُو]نِ"}, {"n": 2, "t": "وَطُورِ سِينِينَ", "p": 597, "tj": "وَطُورِ سِين[p[ِي]نَ"}, {"n": 3, "t": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ", "p": 597, "tj": "وَهَ[n[ـٰ]ذَا [h:14554[ٱ]لْبَلَدِ [h:14555[ٱ]لْأَم[p[ِي]نِ"}, {"n": 4, "t": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ", "p": 597, "tj": "لَقَ[q:2389[دْ] خَلَ[q:5159[قْ]نَا [h:7228[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ ف[o[ِىٓ] أَحْسَنِ تَ[q:14556[قْ]و[p[ِي]مٍ"}, {"n": 5, "t": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ", "p": 597, "tj": "ثُ[g[مّ]َ رَدَ[q:14557[دْ]نَ[n[ـٰ]هُ أَسْفَلَ سَ[n[ـٰ]فِل[p[ِي]نَ"}, {"n": 6, "t": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ", "p": 597, "tj": "إِلَّا [h:778[ٱ]لَّذِينَ ءَامَنُو[s[اْ] وَعَمِلُو[s[اْ] [h:118[ٱ][l[ل]صَّ[n[ـٰ]لِحَ[n[ـٰ]تِ فَلَهُمْ أَ[q:2423[جْ]رٌ غَيْرُ مَمْن[p[ُو]نٍ"}, {"n": 7, "t": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ", "p": 597, "tj": "فَمَا يُكَذِّبُكَ بَعْدُ بِ[h:14361[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 8, "t": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ", "p": 597, "tj": "أَلَيْسَ [h:4087[ٱ]للَّهُ بِأَحْكَمِ [h:14558[ٱ]لْحَ[n[ـٰ]كِم[p[ِي]نَ"}]}