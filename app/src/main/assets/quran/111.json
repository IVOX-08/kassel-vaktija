{"ayahs": [{"n": 1, "t": "تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ", "p": 603, "tj": "تَبَّتْ يَد[o[َآ] أَبِى لَهَ[a:14669[بٍ و]َتَ[q[ب]َّ"}, {"n": 2, "t": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ", "p": 603, "tj": "م[o[َآ] أَغْنَىٰ عَنْهُ مَالُهُ[n[ۥ] وَمَا كَسَ[q[ب]َ"}, {"n": 3, "t": "سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ", "p": 603, "tj": "سَيَصْلَىٰ نَا[f:14670[رًا ذ]َاتَ لَهَ[q[ب]ٍ"}, {"n": 4, "t": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ", "p": 603, "tj": "وَ[h:9999[ٱ]مْرَأَتُهُ[n[ۥ] حَ[g[مّ]َالَةَ [h:14671[ٱ]لْحَطَ[q[ب]ِ"}, {"n": 5, "t": "فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ", "p": 603, "tj": "فِى جِيدِهَا حَ[q:14672[بْ][a:14673[لٌ م]ّ[a:14674[ِن م]َّسَ[q[د]ِۭ"}]}