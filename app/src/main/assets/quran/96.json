{"ayahs": [{"n": 1, "t": "ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ"}, {"n": 2, "t": "خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ"}, {"n": 3, "t": "ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ"}, {"n": 4, "t": "ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ"}, {"n": 5, "t": "عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ"}, {"n": 6, "t": "كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ"}, {"n": 7, "t": "أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ"}, {"n": 8, "t": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ"}, {"n": 9, "t": "أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ"}, {"n": 10, "t": "عَبۡدًا إِذَا صَلَّىٰٓ"}, {"n": 11, "t": "أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ"}, {"n": 12, "t": "أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ"}, {"n": 13, "t": "أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"}, {"n": 14, "t": "أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ"}, {"n": 15, "t": "كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ"}, {"n": 16, "t": "نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ"}, {"n": 17, "t": "فَلۡيَدۡعُ نَادِيَهُۥ"}, {"n": 18, "t": "سَنَدۡعُ ٱلزَّبَانِيَةَ"}, {"n": 19, "t": "كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩"}]}