{"ayahs": [{"n": 1, "t": "ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ", "p": 597, "tj": "ٱ[q:7699[قْ]رَأْ بِ[h:13285[ٱ]سْمِ رَبِّكَ [h:14559[ٱ]لَّذِى خَلَ[q[ق]َ"}, {"n": 2, "t": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ", "p": 597, "tj": "خَلَقَ [h:7324[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مِنْ عَلَ[q[ق]ٍ"}, {"n": 3, "t": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ", "p": 597, "tj": "ٱ[q:7699[قْ]رَأْ وَرَبُّكَ [h:14560[ٱ]لْأَكْرَمُ"}, {"n": 4, "t": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ", "p": 597, "tj": "ٱلَّذِى عَلَّمَ بِ[h:14561[ٱ]لْقَلَمِ"}, {"n": 5, "t": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ", "p": 597, "tj": "عَلَّمَ [h:14562[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مَا لَمْ يَعْلَمْ"}, {"n": 6, "t": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ", "p": 597, "tj": "كَلّ[o[َآ] إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لَيَ[q:14563[طْ]غَىٰٓ"}, {"n": 7, "t": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ", "p": 597, "tj": "أ[u:14564[َن ر]َّءَاهُ [h:14565[ٱ]سْتَغْنَىٰٓ"}, {"n": 8, "t": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ", "p": 597, "tj": "إِ[g[نّ]َ إِلَىٰ رَبِّكَ [h:14566[ٱ][l[ل]رُّ[q:14567[جْ]عَىٰٓ"}, {"n": 9, "t": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ", "p": 597, "tj": "أَرَءَيْتَ [h:14568[ٱ]لَّذِى يَنْهَىٰ"}, {"n": 10, "t": "عَبْدًا إِذَا صَلَّىٰٓ", "p": 597, "tj": "عَ[q:3317[بْ]دًا إِذَا صَلَّىٰٓ"}, {"n": 11, "t": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ", "p": 597, "tj": "أَرَءَيْتَ إِ[f:2594[ن ك]َانَ عَلَى [h:4019[ٱ]لْهُدَىٰٓ"}, {"n": 12, "t": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ", "p": 597, "tj": "أَوْ أَمَرَ بِ[h:14569[ٱ][l[ل]تَّ[q:14569[قْ]وَىٰٓ"}, {"n": 13, "t": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ", "p": 597, "tj": "أَرَءَيْتَ إِ[f:14570[ن ك]َذَّبَ وَتَوَلَّىٰٓ"}, {"n": 14, "t": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ", "p": 597, "tj": "أَلَمْ يَعْل[c:14571[َم ب]ِأَ[g[نّ]َ [h:897[ٱ]للَّهَ يَرَىٰ"}, {"n": 15, "t": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ", "p": 597, "tj": "كَلَّا لَئ[u:4195[ِن ل]َّمْ يَ[f:10891[نت]َهِ لَنَسْفَع[i:14572[َۢا ب]ِ[h:14573[ٱ][l[ل][g[نّ]َاصِيَةِ"}, {"n": 16, "t": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ", "p": 597, "tj": "نَاصِيَ[f:14574[ةٍ ك]َ[n[ـٰ]ذِبَةٍ خَاطِئَةٍ"}, {"n": 17, "t": "فَلْيَدْعُ نَادِيَهُۥ", "p": 597, "tj": "فَلْيَ[q:14575[دْ]عُ نَادِيَهُۥ"}, {"n": 18, "t": "سَنَدْعُ ٱلزَّبَانِيَةَ", "p": 597, "tj": "سَنَ[q:14576[دْ]عُ [h:14577[ٱ][l[ل]زَّبَانِيَةَ"}, {"n": 19, "t": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩", "p": 597, "tj": "كَلَّا لَا تُطِعْهُ وَ[h:14578[ٱ]سْجُ[q:14578[دْ] وَ[h:14579[ٱ][q:14579[قْ]تَرِ[q[ب] ۩"}]}