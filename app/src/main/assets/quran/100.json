{"ayahs": [{"n": 1, "t": "وَٱلْعَٰدِيَٰتِ ضَبْحًۭا", "p": 599, "tj": "وَ[h:9999[ٱ]لْعَ[n[ـٰ]دِيَ[n[ـٰ]تِ ضَ[q:14611[بْ]حًا"}, {"n": 2, "t": "فَٱلْمُورِيَٰتِ قَدْحًۭا", "p": 599, "tj": "فَ[h:9999[ٱ]لْمُورِيَ[n[ـٰ]تِ قَ[q:14612[دْ]حًا"}, {"n": 3, "t": "فَٱلْمُغِيرَٰتِ صُبْحًۭا", "p": 599, "tj": "فَ[h:9999[ٱ]لْمُغِير[n[َٲ]تِ صُ[q:14613[بْ]حًا"}, {"n": 4, "t": "فَأَثَرْنَ بِهِۦ نَقْعًۭا", "p": 599, "tj": "فَأَثَرْنَ بِه[n[ِۦ] نَ[q:14614[قْ]عًا"}, {"n": 5, "t": "فَوَسَطْنَ بِهِۦ جَمْعًا", "p": 599, "tj": "فَوَسَ[q:14615[طْ]نَ بِه[n[ِۦ] جَمْعًا"}, {"n": 6, "t": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ", "p": 599, "tj": "إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لِرَبِّه[n[ِۦ] لَكَن[p[ُو][q[د]ٌ"}, {"n": 7, "t": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ", "p": 599, "tj": "وَإِ[g[نّ]َهُ[n[ۥ] عَلَىٰ ذ[n[َٲ]لِكَ لَشَه[p[ِي][q[د]ٌ"}, {"n": 8, "t": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ", "p": 599, "tj": "وَإِ[g[نّ]َهُ[n[ۥ] لِحُبِّ [h:14616[ٱ]لْخَيْرِ لَشَد[p[ِي][q[د]ٌ"}, {"n": 9, "t": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ", "p": 599, "tj": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى [h:8926[ٱ]لْقُب[p[ُو]رِ"}, {"n": 10, "t": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ", "p": 600, "tj": "وَحُصِّلَ مَا فِى [h:6095[ٱ][l[ل]صُّد[p[ُو]رِ"}, {"n": 11, "t": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ", "p": 600, "tj": "إِ[g[نّ]َ رَبَّه[c:14617[ُم ب]ِهِمْ يَوْمَئِ[u:14618[ذٍ ل]َّخَب[p[ِي]رُۢ"}]}