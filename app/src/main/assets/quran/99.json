{"ayahs": [{"n": 1, "t": "إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا", "p": 599, "tj": "إِذَا زُلْزِلَتِ [h:14601[ٱ]لْأَرْضُ زِلْزَالَهَا"}, {"n": 2, "t": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا", "p": 599, "tj": "وَأَخْرَجَتِ [h:14602[ٱ]لْأَرْضُ أَثْقَالَهَا"}, {"n": 3, "t": "وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا", "p": 599, "tj": "وَقَالَ [h:14603[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مَا لَهَا"}, {"n": 4, "t": "يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا", "p": 599, "tj": "يَوْمَئِ[f:14604[ذٍ ت]ُحَدِّثُ أَخْبَارَهَا"}, {"n": 5, "t": "بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا", "p": 599, "tj": "بِأَ[g[نّ]َ رَبَّكَ أَوْحَىٰ لَهَا"}, {"n": 6, "t": "يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَٰلَهُمْ", "p": 599, "tj": "يَوْمَئِ[a:14605[ذٍ ي]َصْدُرُ [h:14606[ٱ][l[ل][g[نّ]َاسُ أَشْتَا[u:14607[تًا ل]ِّيُرَوْ[s[اْ] أَعْمَ[n[ـٰ]لَهُمْ"}, {"n": 7, "t": "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ", "p": 599, "tj": "فَم[a:8855[َن ي]َعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْ[a:14608[رًا ي]َرَهُۥ"}, {"n": 8, "t": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ", "p": 599, "tj": "وَم[a:3112[َن ي]َعْمَلْ مِثْقَالَ ذَرَّ[f:14609[ةٍ ش]َر[a:14610[ًّا ي]َرَهُۥ"}]}