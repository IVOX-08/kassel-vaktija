{"ayahs": [{"n": 1, "t": "وَٱلصَّـٰٓفَّـٰتِ صَفّٗا"}, {"n": 2, "t": "فَٱلزَّـٰجِرَٰتِ زَجۡرٗا"}, {"n": 3, "t": "فَٱلتَّـٰلِيَٰتِ ذِكۡرًا"}, {"n": 4, "t": "إِنَّ إِلَٰهَكُمۡ لَوَٰحِدٞ"}, {"n": 5, "t": "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ"}, {"n": 6, "t": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ"}, {"n": 7, "t": "وَحِفۡظٗا مِّن كُلِّ شَيۡطَٰنٖ مَّارِدٖ"}, {"n": 8, "t": "لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبٖ"}, {"n": 9, "t": "دُحُورٗاۖ وَلَهُمۡ عَذَابٞ وَاصِبٌ"}, {"n": 10, "t": "إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابٞ ثَاقِبٞ"}, {"n": 11, "t": "فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينٖ لَّازِبِۭ"}, {"n": 12, "t": "بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ"}, {"n": 13, "t": "وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ"}, {"n": 14, "t": "وَإِذَا رَأَوۡاْ ءَايَةٗ يَسۡتَسۡخِرُونَ"}, {"n": 15, "t": "وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٌ"}, {"n": 16, "t": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ"}, {"n": 17, "t": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ"}, {"n": 18, "t": "قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ"}, {"n": 19, "t": "فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمۡ يَنظُرُونَ"}, {"n": 20, "t": "وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ"}, {"n": 21, "t": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ"}, {"n": 22, "t": "۞ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ"}, {"n": 23, "t": "مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ"}, {"n": 24, "t": "وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ"}, {"n": 25, "t": "مَا لَكُمۡ لَا تَنَاصَرُونَ"}, {"n": 26, "t": "بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ"}, {"n": 27, "t": "وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ"}, {"n": 28, "t": "قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ"}, {"n": 29, "t": "قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ"}, {"n": 30, "t": "وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمٗا طَٰغِينَ"}, {"n": 31, "t": "فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ"}, {"n": 32, "t": "فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ"}, {"n": 33, "t": "فَإِنَّهُمۡ يَوۡمَئِذٖ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ"}, {"n": 34, "t": "إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ"}, {"n": 35, "t": "إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ"}, {"n": 36, "t": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۭ"}, {"n": 37, "t": "بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ"}, {"n": 38, "t": "إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ"}, {"n": 39, "t": "وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ"}, {"n": 40, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ"}, {"n": 41, "t": "أُوْلَـٰٓئِكَ لَهُمۡ رِزۡقٞ مَّعۡلُومٞ"}, {"n": 42, "t": "فَوَٰكِهُ وَهُم مُّكۡرَمُونَ"}, {"n": 43, "t": "فِي جَنَّـٰتِ ٱلنَّعِيمِ"}, {"n": 44, "t": "عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ"}, {"n": 45, "t": "يُطَافُ عَلَيۡهِم بِكَأۡسٖ مِّن مَّعِينِۭ"}, {"n": 46, "t": "بَيۡضَآءَ لَذَّةٖ لِّلشَّـٰرِبِينَ"}, {"n": 47, "t": "لَا فِيهَا غَوۡلٞ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ"}, {"n": 48, "t": "وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينٞ"}, {"n": 49, "t": "كَأَنَّهُنَّ بَيۡضٞ مَّكۡنُونٞ"}, {"n": 50, "t": "فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ"}, {"n": 51, "t": "قَالَ قَآئِلٞ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينٞ"}, {"n": 52, "t": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ"}, {"n": 53, "t": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ"}, {"n": 54, "t": "قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ"}, {"n": 55, "t": "فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ"}, {"n": 56, "t": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ"}, {"n": 57, "t": "وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ"}, {"n": 58, "t": "أَفَمَا نَحۡنُ بِمَيِّتِينَ"}, {"n": 59, "t": "إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ"}, {"n": 60, "t": "إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ"}, {"n": 61, "t": "لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ"}, {"n": 62, "t": "أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ"}, {"n": 63, "t": "إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّـٰلِمِينَ"}, {"n": 64, "t": "إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ"}, {"n": 65, "t": "طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ"}, {"n": 66, "t": "فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ"}, {"n": 67, "t": "ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ"}, {"n": 68, "t": "ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ"}, {"n": 69, "t": "إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ"}, {"n": 70, "t": "فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ"}, {"n": 71, "t": "وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ"}, {"n": 72, "t": "وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ"}, {"n": 73, "t": "فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ"}, {"n": 74, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ"}, {"n": 75, "t": "وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ ٱلۡمُجِيبُونَ"}, {"n": 76, "t": "وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ"}, {"n": 77, "t": "وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ"}, {"n": 78, "t": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ"}, {"n": 79, "t": "سَلَٰمٌ عَلَىٰ نُوحٖ فِي ٱلۡعَٰلَمِينَ"}, {"n": 80, "t": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"}, {"n": 81, "t": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ"}, {"n": 82, "t": "ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ"}, {"n": 83, "t": "۞وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ"}, {"n": 84, "t": "إِذۡ جَآءَ رَبَّهُۥ بِقَلۡبٖ سَلِيمٍ"}, {"n": 85, "t": "إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ"}, {"n": 86, "t": "أَئِفۡكًا ءَالِهَةٗ دُونَ ٱللَّهِ تُرِيدُونَ"}, {"n": 87, "t": "فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَٰلَمِينَ"}, {"n": 88, "t": "فَنَظَرَ نَظۡرَةٗ فِي ٱلنُّجُومِ"}, {"n": 89, "t": "فَقَالَ إِنِّي سَقِيمٞ"}, {"n": 90, "t": "فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ"}, {"n": 91, "t": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ"}, {"n": 92, "t": "مَا لَكُمۡ لَا تَنطِقُونَ"}, {"n": 93, "t": "فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِٱلۡيَمِينِ"}, {"n": 94, "t": "فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ"}, {"n": 95, "t": "قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ"}, {"n": 96, "t": "وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ"}, {"n": 97, "t": "قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنٗا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ"}, {"n": 98, "t": "فَأَرَادُواْ بِهِۦ كَيۡدٗا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ"}, {"n": 99, "t": "وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ"}, {"n": 100, "t": "رَبِّ هَبۡ لِي مِنَ ٱلصَّـٰلِحِينَ"}, {"n": 101, "t": "فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمٖ"}, {"n": 102, "t": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَـٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّـٰبِرِينَ"}, {"n": 103, "t": "فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ"}, {"n": 104, "t": "وَنَٰدَيۡنَٰهُ أَن يَـٰٓإِبۡرَٰهِيمُ"}, {"n": 105, "t": "قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"}, {"n": 106, "t": "إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَـٰٓؤُاْ ٱلۡمُبِينُ"}, {"n": 107, "t": "وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمٖ"}, {"n": 108, "t": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ"}, {"n": 109, "t": "سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ"}, {"n": 110, "t": "كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"}, {"n": 111, "t": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ"}, {"n": 112, "t": "وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيّٗا مِّنَ ٱلصَّـٰلِحِينَ"}, {"n": 113, "t": "وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنٞ وَظَالِمٞ لِّنَفۡسِهِۦ مُبِينٞ"}, {"n": 114, "t": "وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ"}, {"n": 115, "t": "وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ"}, {"n": 116, "t": "وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ"}, {"n": 117, "t": "وَءَاتَيۡنَٰهُمَا ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ"}, {"n": 118, "t": "وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ"}, {"n": 119, "t": "وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ"}, {"n": 120, "t": "سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ"}, {"n": 121, "t": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"}, {"n": 122, "t": "إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ"}, {"n": 123, "t": "وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ"}, {"n": 124, "t": "إِذۡ قَالَ لِقَوۡمِهِۦٓ أَلَا تَتَّقُونَ"}, {"n": 125, "t": "أَتَدۡعُونَ بَعۡلٗا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَٰلِقِينَ"}, {"n": 126, "t": "ٱللَّهَ رَبَّكُمۡ وَرَبَّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ"}, {"n": 127, "t": "فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ"}, {"n": 128, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ"}, {"n": 129, "t": "وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ"}, {"n": 130, "t": "سَلَٰمٌ عَلَىٰٓ إِلۡ يَاسِينَ"}, {"n": 131, "t": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"}, {"n": 132, "t": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ"}, {"n": 133, "t": "وَإِنَّ لُوطٗا لَّمِنَ ٱلۡمُرۡسَلِينَ"}, {"n": 134, "t": "إِذۡ نَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ"}, {"n": 135, "t": "إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ"}, {"n": 136, "t": "ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ"}, {"n": 137, "t": "وَإِنَّكُمۡ لَتَمُرُّونَ عَلَيۡهِم مُّصۡبِحِينَ"}, {"n": 138, "t": "وَبِٱلَّيۡلِۚ أَفَلَا تَعۡقِلُونَ"}, {"n": 139, "t": "وَإِنَّ يُونُسَ لَمِنَ ٱلۡمُرۡسَلِينَ"}, {"n": 140, "t": "إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ"}, {"n": 141, "t": "فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ"}, {"n": 142, "t": "فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمٞ"}, {"n": 143, "t": "فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ"}, {"n": 144, "t": "لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ"}, {"n": 145, "t": "۞فَنَبَذۡنَٰهُ بِٱلۡعَرَآءِ وَهُوَ سَقِيمٞ"}, {"n": 146, "t": "وَأَنۢبَتۡنَا عَلَيۡهِ شَجَرَةٗ مِّن يَقۡطِينٖ"}, {"n": 147, "t": "وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ"}, {"n": 148, "t": "فَـَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينٖ"}, {"n": 149, "t": "فَٱسۡتَفۡتِهِمۡ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ"}, {"n": 150, "t": "أَمۡ خَلَقۡنَا ٱلۡمَلَـٰٓئِكَةَ إِنَٰثٗا وَهُمۡ شَٰهِدُونَ"}, {"n": 151, "t": "أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ"}, {"n": 152, "t": "وَلَدَ ٱللَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ"}, {"n": 153, "t": "أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ"}, {"n": 154, "t": "مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ"}, {"n": 155, "t": "أَفَلَا تَذَكَّرُونَ"}, {"n": 156, "t": "أَمۡ لَكُمۡ سُلۡطَٰنٞ مُّبِينٞ"}, {"n": 157, "t": "فَأۡتُواْ بِكِتَٰبِكُمۡ إِن كُنتُمۡ صَٰدِقِينَ"}, {"n": 158, "t": "وَجَعَلُواْ بَيۡنَهُۥ وَبَيۡنَ ٱلۡجِنَّةِ نَسَبٗاۚ وَلَقَدۡ عَلِمَتِ ٱلۡجِنَّةُ إِنَّهُمۡ لَمُحۡضَرُونَ"}, {"n": 159, "t": "سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ"}, {"n": 160, "t": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ"}, {"n": 161, "t": "فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ"}, {"n": 162, "t": "مَآ أَنتُمۡ عَلَيۡهِ بِفَٰتِنِينَ"}, {"n": 163, "t": "إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِيمِ"}, {"n": 164, "t": "وَمَامِنَّآ إِلَّا لَهُۥ مَقَامٞ مَّعۡلُومٞ"}, {"n": 165, "t": "وَإِنَّا لَنَحۡنُ ٱلصَّآفُّونَ"}, {"n": 166, "t": "وَإِنَّا لَنَحۡنُ ٱلۡمُسَبِّحُونَ"}, {"n": 167, "t": "وَإِن كَانُواْ لَيَقُولُونَ"}, {"n": 168, "t": "لَوۡ أَنَّ عِندَنَا ذِكۡرٗا مِّنَ ٱلۡأَوَّلِينَ"}, {"n": 169, "t": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ"}, {"n": 170, "t": "فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ"}, {"n": 171, "t": "وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ"}, {"n": 172, "t": "إِنَّهُمۡ لَهُمُ ٱلۡمَنصُورُونَ"}, {"n": 173, "t": "وَإِنَّ جُندَنَا لَهُمُ ٱلۡغَٰلِبُونَ"}, {"n": 174, "t": "فَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ"}, {"n": 175, "t": "وَأَبۡصِرۡهُمۡ فَسَوۡفَ يُبۡصِرُونَ"}, {"n": 176, "t": "أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ"}, {"n": 177, "t": "فَإِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ ٱلۡمُنذَرِينَ"}, {"n": 178, "t": "وَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ"}, {"n": 179, "t": "وَأَبۡصِرۡ فَسَوۡفَ يُبۡصِرُونَ"}, {"n": 180, "t": "سُبۡحَٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا يَصِفُونَ"}, {"n": 181, "t": "وَسَلَٰمٌ عَلَى ٱلۡمُرۡسَلِينَ"}, {"n": 182, "t": "وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ"}]}