{"ayahs": [{"n": 1, "t": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ", "p": 587, "tj": "إِذَا [h:14351[ٱ][l[ل]سَّم[o[َا]ٓءُ [h:14352[ٱ][f:14353[نف]َطَرَتْ"}, {"n": 2, "t": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ", "p": 587, "tj": "وَإِذَا [h:14354[ٱ]لْكَوَاكِبُ [h:14355[ٱ][f:14356[نت]َثَرَتْ"}, {"n": 3, "t": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ", "p": 587, "tj": "وَإِذَا [h:14337[ٱ]لْبِحَارُ فُجِّرَتْ"}, {"n": 4, "t": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ", "p": 587, "tj": "وَإِذَا [h:14357[ٱ]لْقُبُورُ بُعْثِرَتْ"}, {"n": 5, "t": "عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ", "p": 587, "tj": "عَلِمَتْ نَفْ[a:10644[سٌ م]َّا قَدَّمَتْ وَأَخَّرَتْ"}, {"n": 6, "t": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ", "p": 587, "tj": "يَ[o[ـٰٓ]أَيُّهَا [h:14358[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مَا غَرَّكَ بِرَبِّكَ [h:14359[ٱ]لْكَر[p[ِي]مِ"}, {"n": 7, "t": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ", "p": 587, "tj": "ٱلَّذِى خَلَقَكَ فَسَوَّ[n[ٮٰ]كَ فَعَدَلَكَ"}, {"n": 8, "t": "فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ", "p": 587, "tj": "ف[o[ِىٓ] أَىِّ صُورَ[a:14360[ةٍ م]َّا ش[o[َا]ٓءَ رَكَّبَكَ"}, {"n": 9, "t": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ", "p": 587, "tj": "كَلَّا بَلْ تُكَذِّبُونَ بِ[h:14361[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 10, "t": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ", "p": 587, "tj": "وَإِ[g[نّ]َ عَلَيْكُمْ لَحَ[n[ـٰ]فِظ[p[ِي]نَ"}, {"n": 11, "t": "كِرَامًۭا كَٰتِبِينَ", "p": 587, "tj": "كِرَا[f:14362[مًا ك]َ[n[ـٰ]تِب[p[ِي]نَ"}, {"n": 12, "t": "يَعْلَمُونَ مَا تَفْعَلُونَ", "p": 587, "tj": "يَعْلَمُونَ مَا تَفْعَل[p[ُو]نَ"}, {"n": 13, "t": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ", "p": 587, "tj": "إِ[g[نّ]َ [h:14162[ٱ]لْأَ[q:14163[بْ]رَارَ لَفِى نَع[p[ِي]مٍ"}, {"n": 14, "t": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ", "p": 587, "tj": "وَإِ[g[نّ]َ [h:14363[ٱ]لْفُجَّارَ لَفِى جَح[p[ِي]مٍ"}, {"n": 15, "t": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ", "p": 587, "tj": "يَصْلَوْنَهَا يَوْمَ [h:9781[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 16, "t": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ", "p": 587, "tj": "وَمَا هُمْ عَنْهَا بِغ[o[َا]ٓئِب[p[ِي]نَ"}, {"n": 17, "t": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "p": 587, "tj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11335[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 18, "t": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ", "p": 587, "tj": "ثُ[g[مّ]َ م[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11335[ٱ][l[ل]دّ[p[ِي]نِ"}, {"n": 19, "t": "يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ", "p": 587, "tj": "يَوْمَ لَا تَمْلِكُ نَفْ[u:14364[سٌ ل]ِّنَفْ[f:14365[سٍ ش]َيْـ[a:14366[ـًٔا‌ۖ و]َ[h:4748[ٱ]لْأَمْرُ يَوْمَئِ[u:9076[ذٍ ل]ِّلَّهِ"}]}