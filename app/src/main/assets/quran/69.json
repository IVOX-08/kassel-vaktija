{"ayahs": [{"n": 1, "t": "ٱلْحَآقَّةُ", "p": 566, "tj": "ٱلْح[m[َا]ٓقَّةُ"}, {"n": 2, "t": "مَا ٱلْحَآقَّةُ", "p": 566, "tj": "مَا [h:13857[ٱ]لْح[m[َا]ٓقَّةُ"}, {"n": 3, "t": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ", "p": 566, "tj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:13857[ٱ]لْح[m[َا]ٓقَّةُ"}, {"n": 4, "t": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ", "p": 566, "tj": "كَذَّبَتْ ثَمُودُ وَعَا[i:13859[دُۢ ب]ِ[h:13860[ٱ]لْقَارِعَةِ"}, {"n": 5, "t": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ", "p": 566, "tj": "فَأَ[g[مّ]َا ثَمُودُ فَأُهْلِكُو[s[اْ] بِ[h:13861[ٱ][l[ل]طَّاغِيَةِ"}, {"n": 6, "t": "وَأَمَّا عَادٌۭ فَأُهْلِكُوا۟ بِرِيحٍۢ صَرْصَرٍ عَاتِيَةٍۢ", "p": 566, "tj": "وَأَ[g[مّ]َا عَا[f:13862[دٌ ف]َأُهْلِكُو[s[اْ] بِرِي[f:13863[حٍ ص]َرْصَرٍ عَاتِيَةٍ"}, {"n": 7, "t": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍۢ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًۭا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍۢ", "p": 566, "tj": "سَخَّرَهَا عَلَيْهِمْ سَ[q:158[بْ]عَ لَيَا[a:13864[لٍ و]َثَمَ[n[ـٰ]نِيَةَ أَيَّامٍ حُسُو[f:13865[مًا ف]َتَرَى [h:13866[ٱ]لْقَوْمَ فِيهَا صَرْعَىٰ كَأَ[g[نّ]َهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ"}, {"n": 8, "t": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍۢ", "p": 566, "tj": "فَهَلْ تَرَىٰ لَه[w:1812[ُم م]ّ[i:13867[ِنۢ ب]َاقِيَةٍ"}, {"n": 9, "t": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ", "p": 567, "tj": "وَج[o[َا]ٓءَ فِرْعَوْنُ وَمَ[f:13868[ن ق]َ[q:13869[بْ]لَهُ[n[ۥ] وَ[h:13870[ٱ]لْمُؤْتَفِكَ[n[ـٰ]تُ بِ[h:13871[ٱ]لْخَاطِئَةِ"}, {"n": 10, "t": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةًۭ رَّابِيَةً", "p": 567, "tj": "فَعَصَوْ[s[اْ] رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَ[u:13872[ةً ر]َّابِيَةً"}, {"n": 11, "t": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ", "p": 567, "tj": "إِ[g[نّ]َا لَ[g[مّ]َا طَغَا [h:13873[ٱ]لْم[o[َا]ٓءُ حَمَلْنَ[n[ـٰ]كُمْ فِى [h:13874[ٱ]لْجَارِيَةِ"}, {"n": 12, "t": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةًۭ وَتَعِيَهَآ أُذُنٌۭ وَٰعِيَةٌۭ", "p": 567, "tj": "لِنَ[q:13875[جْ]عَلَهَ