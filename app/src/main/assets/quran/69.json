[s[اْ] وَ[h:300[ٱ]شْرَبُو[s[اْ] هَنِ[o[يٓـ]ـ[i:12907[ـَٔۢا ب]ِم[o[َآ] أَسْلَفْتُمْ فِى [h:13891[ٱ]لْأَيَّامِ [h:13892[ٱ]لْخَالِيَةِ"}, {"n": 25, "t": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ", "p": 567, "tj": "وَأَ[g[مّ]َا مَنْ أُوتِىَ كِتَ[n[ـٰ]بَهُ[n[ۥ] بِشِمَالِه[n[ِۦ] فَيَقُولُ يَ[n[ـٰ]لَيْتَنِى لَمْ أُوتَ كِتَ[n[ـٰ]بِيَهْ"}, {"n": 26, "t": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ", "p": 567, "tj": "وَلَمْ أَ[q:13893[دْ]رِ مَا حِسَابِيَهْ"}, {"n": 27, "t": "يَٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ", "p": 567, "tj": "يَ[n[ـٰ]لَيْتَهَا كَانَتِ [h:13894[ٱ]لْقَاضِيَةَ"}, {"n": 28, "t": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ", "p": 567, "tj": "م[o[َآ] أَغْنَىٰ عَ[g[نّ]ِى مَالِيَهْۜ"}, {"n": 29, "t": "هَلَكَ عَنِّى سُلْطَٰنِيَهْ", "p": 567, "tj": "هَلَكَ عَ[g[نّ]ِى سُلْطَ[n[ـٰ]نِيَهْ"}, {"n": 30, "t": "خُذُوهُ فَغُلُّوهُ", "p": 567, "tj": "خُذُوهُ فَغُلّ[p[ُو]هُ"}, {"n": 31, "t": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ", "p": 567, "tj": "ثُ[g[مّ]َ [h:13895[ٱ]لْجَحِيمَ صَلّ[p[ُو]هُ"}, {"n": 32, "t": "ثُمَّ فِى سِلْسِلَةٍۢ ذَرْعُهَا سَبْعُونَ ذِرَاعًۭا فَٱسْلُكُوهُ", "p": 567, "tj": "ثُ[g[مّ]َ فِى سِلْسِلَ[f:13896[ةٍ ذ]َرْعُهَا سَ[q:13897[بْ]عُونَ ذِرَا[f:13898[عًا ف]َ[h:13899[ٱ]سْلُك[p[ُو]هُ"}, {"n": 33, "t": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ", "p": 567, "tj": "إِ[g[نّ]َهُ[n[ۥ] كَانَ لَا يُؤْمِنُ بِ[h:32[ٱ]للَّهِ [h:13900[ٱ]لْعَظ[p[ِي]مِ"}, {"n": 34, "t": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "p": 567, "tj": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ [h:13901[ٱ]لْمِسْك[p[ِي]نِ"}, {"n": 35, "t": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌۭ", "p": 568, "tj": "فَلَيْسَ لَهُ [h:13902[ٱ]لْيَوْمَ هَ[n[ـٰ]هُنَا حَم[p[ِي]مٌ"}, {"n": 36, "t": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍۢ", "p": 568, "tj": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْل[p[ِي]نٍ"}, {"n": 37, "t": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ", "p": 568, "tj": "لَّا يَأْكُلُهُ[o[ۥٓ] إِلَّا [h:13903[ٱ]لْخَ[n[ـٰ]طِــٔ[p[ُو]نَ"}, {"n": 38, "t": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ", "p": 568, "tj": "فَل[o[َآ] أُ[q:13287[قْ]سِمُ بِمَا تُ[q:8674[بْ]صِر[p[ُو]نَ"}, {"n": 39, "t": "وَمَا لَا تُبْصِرُونَ", "p": 568, "tj": "وَمَا لَا تُ[q:8674[بْ]صِر[p[ُو]نَ"}, {"n": 40, "t": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "p": 568, "tj": "إِ[g[نّ]َهُ[n[ۥ] لَقَوْلُ رَسُو[f:13904[لٍ ك]َر[p[ِي]مٍ"}, {"n": 41, "t": "وَمَا هُوَ بِقَوْلِ شَاعِرٍۢ ۚ قَلِيلًۭا مَّا تُؤْمِنُونَ", "p": 568, "tj": "وَمَا هُوَ بِقَوْلِ شَاعِ[f:13905[رٍ‌ۚ ق]َلِيل[a:4583[اً م]َّا تُؤْمِن[p[ُو]نَ"}, {"n": 42, "t": "وَلَا بِقَوْلِ كَاهِنٍۢ ۚ قَلِيلًۭا مَّا تَذَكَّرُونَ", "p": 568, "tj": "وَلَا بِقَوْلِ كَاهِ[f:13906[نٍ‌ۚ ق]َلِيل[a:4583[اً م]َّا تَذَكَّر[p[ُو]نَ"}, {"n": 43, "t": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ", "p": 568, "tj": "تَ[f:11949[نز]ِي[a:12045[لٌ م]ّ[u:4772[ِن ر]َّبِّ [h:4[ٱ]لْعَ[n[ـٰ]لَم[p[ِي]نَ"}, {"n": 44, "t": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ", "p": 568, "tj": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ [h:13907[ٱ]لْأَقَاو[p[ِي]لِ"}, {"n": 45, "t": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ", "p": 568, "tj": "لَأَخَذْنَا مِنْهُ بِ[h:11402[ٱ]لْيَم[p[ِي]نِ"}, {"n": 46, "t": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ", "p": 568, "tj": "ثُ[g[مّ]َ لَقَطَعْنَا مِنْهُ [h:13908[ٱ]لْوَت[p[ِي]نَ"}, {"n": 47, "t": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ", "p": 568, "tj": "فَمَا مِ[f:344[نك][w:431[ُم م]ِّنْ أَحَدٍ عَنْهُ حَ[n[ـٰ]جِز[p[ِي]نَ"}, {"n": 48, "t": "وَإِنَّهُۥ لَتَذْكِرَةٌۭ لِّلْمُتَّقِينَ", "p": 568, "tj": "وَإِ[g[نّ]َهُ[n[ۥ] لَتَذْكِرَ[u:13909[ةٌ ل]ِّلْمُتَّق[p[ِي]نَ"}, {"n": 49, "t": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ", "p": 568, "tj": "وَإِ[g[نّ]َا لَنَعْلَمُ أَ[g[نّ]َ مِ[f:344[نك][w:13910[ُم م]ُّكَذِّب[p[ِي]نَ"}, {"n": 50, "t": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ", "p": 568, "tj": "وَإِ[g[نّ]َهُ[n[ۥ] لَحَسْرَةٌ عَلَى [h:468[ٱ]لْكَ[n[ـٰ]فِر[p[ِي]نَ"}, {"n": 51, "t": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ", "p": 568, "tj": "وَإِ[g[نّ]َهُ[n[ۥ] لَحَقُّ [h:13911[ٱ]لْيَق[p[ِي]نِ"}, {"n": 52, "t": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ", "p": 568, "tj": "فَسَبِّحْ بِ[h:13285[ٱ]سْمِ رَبِّك