{"ayahs": [{"n": 1, "t": "وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ"}, {"n": 2, "t": "ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ"}, {"n": 3, "t": "يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ"}, {"n": 4, "t": "كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ"}, {"n": 5, "t": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ"}, {"n": 6, "t": "نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ"}, {"n": 7, "t": "ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ"}, {"n": 8, "t": "إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ"}, {"n": 9, "t": "فِي عَمَدٖ مُّمَدَّدَةِۭ"}]}