{"ayahs": [{"n": 1, "t": "أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ", "p": 602}, {"n": 2, "t": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ", "p": 602}, {"n": 3, "t": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "p": 602}, {"n": 4, "t": "فَوَيْلٌۭ لِّلْمُصَلِّينَ", "p": 602}, {"n": 5, "t": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "p": 602}, {"n": 6, "t": "ٱلَّذِينَ هُمْ يُرَآءُونَ", "p": 602}, {"n": 7, "t": "وَيَمْنَعُونَ ٱلْمَاعُونَ", "p": 602}]}