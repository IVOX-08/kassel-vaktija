{"ayahs": [{"n": 1, "t": "وَٱلَّيْلِ إِذَا يَغْشَىٰ", "p": 595, "tj": "وَ[h:9999[ٱ]لَّيْلِ إِذَا يَغْشَىٰ"}, {"n": 2, "t": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ", "p": 595, "tj": "وَ[h:9999[ٱ][l[ل][g[نّ]َهَارِ إِذَا تَجَلَّىٰ"}, {"n": 3, "t": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "p": 595, "tj": "وَمَا خَلَقَ [h:14531[ٱ][l[ل]ذَّكَرَ وَ[h:929[ٱ]لْأُ[f:929[نث]َىٰٓ"}, {"n": 4, "t": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ", "p": 595, "tj": "إِ[g[نّ]َ سَعْيَكُمْ لَشَتَّىٰ"}, {"n": 5, "t": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ", "p": 595, "tj": "فَأَ[g[مّ]َا مَنْ أَعْطَىٰ وَ[h:2036[ٱ]تَّقَىٰ"}, {"n": 6, "t": "وَصَدَّقَ بِٱلْحُسْنَىٰ", "p": 595, "tj": "وَصَدَّقَ بِ[h:13002[ٱ]لْحُسْنَىٰ"}, {"n": 7, "t": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ", "p": 595, "tj": "فَسَنُيَسِّرُهُ[n[ۥ] لِلْيُسْرَىٰ"}, {"n": 8, "t": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ", "p": 595, "tj": "وَأَ[g[مّ]َا م[i:14532[َنۢ ب]َخِلَ وَ[h:13634[ٱ]سْتَغْنَىٰ"}, {"n": 9, "t": "وَكَذَّبَ بِٱلْحُسْنَىٰ", "p": 595, "tj": "وَكَذَّبَ بِ[h:13002[ٱ]لْحُسْنَىٰ"}, {"n": 10, "t": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ", "p": 595, "tj": "فَسَنُيَسِّرُهُ[n[ۥ] لِلْعُسْرَىٰ"}, {"n": 11, "t": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ", "p": 595, "tj": "وَمَا يُغْنِى عَنْهُ مَالُهُ[o[ۥٓ] إِذَا تَرَدَّىٰٓ"}, {"n": 12, "t": "إِنَّ عَلَيْنَا لَلْهُدَىٰ", "p": 595, "tj": "إِ[g[نّ]َ عَلَيْنَا لَلْهُدَىٰ"}, {"n": 13, "t": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ", "p": 595, "tj": "وَإِ[g[نّ]َ لَنَا لَلْأَخِرَةَ وَ[h:12987[ٱ]لْأُولَىٰ"}, {"n": 14, "t": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ", "p": 595, "tj": "فَأَ[f:14533[نذ]َرْتُكُمْ نَا[f:14534[رًا ت]َلَظَّىٰ"}, {"n": 15, "t": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى", "p": 596, "tj": "لَا يَصْلَ[n[ـٰ]ه[o[َآ] إِلَّا [h:14535[ٱ]لْأَشْقَى"}, {"n": 16, "t": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ", "p": 596, "tj": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"}, {"n": 17, "t": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى", "p": 596, "tj": "وَسَيُجَ[g[نّ]َبُهَا [h:14536[ٱ]لْأَتْقَى"}, {"n": 18, "t": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ", "p": 596, "tj": "ٱلَّذِى يُؤْتِى مَالَهُ[n[ۥ] يَتَزَكَّىٰ"}, {"n": 19, "t": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ", "p": 596, "tj": "وَمَا لِأَحَدٍ عِ[f:719[ند]َهُ[n[ۥ] م[a:7433[ِن ن]ِّعْمَ[f:14537[ةٍ ت]ُ[q:11814[جْ]زَىٰٓ"}, {"n": 20, "t": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ", "p": 596, "tj": "إِلَّا [h:1610[ٱ][q:1130[بْ]تِغ[o[َا]ٓءَ وَ[q:1611[جْ]هِ رَبِّهِ [h:14538[ٱ]لْأَعْلَىٰ"}, {"n": 21, "t": "وَلَسَوْفَ يَرْضَىٰ", "p": 596, "tj": "وَلَسَوْفَ يَرْضَىٰ"}]}