{"ayahs": [{"n": 1, "t": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ"}, {"n": 2, "t": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"}, {"n": 3, "t": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ"}, {"n": 4, "t": "إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ"}, {"n": 5, "t": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ"}, {"n": 6, "t": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ"}, {"n": 7, "t": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ"}, {"n": 8, "t": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ"}, {"n": 9, "t": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ"}, {"n": 10, "t": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ"}, {"n": 11, "t": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"}, {"n": 12, "t": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ"}, {"n": 13, "t": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ"}, {"n": 14, "t": "فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ"}, {"n": 15, "t": "لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى"}, {"n": 16, "t": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ"}, {"n": 17, "t": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى"}, {"n": 18, "t": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ"}, {"n": 19, "t": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ"}, {"n": 20, "t": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ"}, {"n": 21, "t": "وَلَسَوۡفَ يَرۡضَىٰ"}]}