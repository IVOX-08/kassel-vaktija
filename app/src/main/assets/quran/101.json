{"ayahs": [{"n": 1, "t": "ٱلۡقَارِعَةُ"}, {"n": 2, "t": "مَا ٱلۡقَارِعَةُ"}, {"n": 3, "t": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ"}, {"n": 4, "t": "يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ"}, {"n": 5, "t": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ"}, {"n": 6, "t": "فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ"}, {"n": 7, "t": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ"}, {"n": 8, "t": "وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ"}, {"n": 9, "t": "فَأُمُّهُۥ هَاوِيَةٞ"}, {"n": 10, "t": "وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ"}, {"n": 11, "t": "نَارٌ حَامِيَةُۢ"}]}