{"ayahs": [{"n": 1, "t": "لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ", "p": 594, "tj": "ل[o[َآ] أُ[q:13287[قْ]سِمُ بِهَ[n[ـٰ]ذَا [h:14500[ٱ]لْبَلَ[q[د]ِ"}, {"n": 2, "t": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ", "p": 594, "tj": "وَأَ[f:3893[نت]َ حِل[i:14501[ُّۢ ب]ِهَ[n[ـٰ]ذَا [h:14500[ٱ]لْبَلَ[q[د]ِ"}, {"n": 3, "t": "وَوَالِدٍۢ وَمَا وَلَدَ", "p": 594, "tj": "وَوَالِ[a:14502[دٍ و]َمَا وَلَ[q[د]َ"}, {"n": 4, "t": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ", "p": 594, "tj": "لَقَ[q:2389[دْ] خَلَ[q:5159[قْ]نَا [h:7228[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ فِى كَبَ[q[د]ٍ"}, {"n": 5, "t": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ", "p": 594, "tj": "أَيَحْسَبُ أ[u:8842[َن ل]ّ[a:14503[َن ي]َ[q:14504[قْ]دِرَ عَلَيْهِ أَحَ[q[د]ٌ"}, {"n": 6, "t": "يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا", "p": 594, "tj": "يَقُولُ أَهْلَكْتُ مَال[u:14505[اً ل]ُّبَدًا"}, {"n": 7, "t": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ", "p": 594, "tj": "أَيَحْسَبُ أ[u:4423[َن ل]َّمْ يَرَهُ[o[ۥٓ] أَحَ[q[د]ٌ"}, {"n": 8, "t": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ", "p": 594, "tj": "أَلَمْ نَ[q:8219[جْ]عَل لَّهُ[n[ۥ] عَيْنَ[p[يْ]نِ"}, {"n": 9, "t": "وَلِسَانًۭا وَشَفَتَيْنِ", "p": 594, "tj": "وَلِسَا[a:14506[نًا و]َشَفَتَ[p[يْ]نِ"}, {"n": 10, "t": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ", "p": 594, "tj": "وَهَدَيْنَ[n[ـٰ]هُ [h:14507[ٱ][l[ل][g[نّ]َ[q:14508[جْ]دَ[p[يْ]نِ"}, {"n": 11, "t": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ", "p": 594, "tj": "فَلَا [h:14509[ٱ][q:14510[قْ]تَحَمَ [h:14511[ٱ]لْعَقَبَةَ"}, {"n": 12, "t": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ", "p": 594, "tj": "وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14512[ٱ]لْعَقَبَةُ"}, {"n": 13, "t": "فَكُّ رَقَبَةٍ", "p": 594, "tj": "فَكُّ رَقَبَةٍ"}, {"n": 14, "t": "أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ", "p": 594, "tj": "أَوْ إِ[q:14513[طْ]عَ[n[ـٰ][f:14514[مٌ ف]ِى يَوْ[f:14515[مٍ ذ]ِى مَسْغَبَةٍ"}, {"n": 15, "t": "يَتِيمًۭا ذَا مَقْرَبَةٍ", "p": 594, "tj": "يَتِي[f:14516[مًا ذ]َا مَ[q:14517[قْ]رَبَةٍ"}, {"n": 16, "t": "أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ", "p": 594, "tj": "أَوْ مِسْكِي[f:14518[نًا ذ]َا مَتْرَبَةٍ"}, {"n": 17, "t": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ", "p": 594, "tj": "ثُ[g[مّ]َ كَانَ مِنَ [h:523[ٱ]لَّذِينَ ءَامَنُو[s[اْ] وَتَوَاصَوْ[s[اْ] بِ[h:223[ٱ][l[ل]صَّ[q:223[بْ]رِ وَتَوَاصَوْ[s[اْ] بِ[h:14519[ٱ]لْمَرْحَمَةِ"}, {"n": 18, "t": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ", "p": 594, "tj": "أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ أَصْحَ[n[ـٰ]بُ [h:13209[ٱ]لْمَيْمَنَةِ"}, {"n": 19, "t": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ", "p": 594, "tj": "وَ[h:9999[ٱ]لَّذِينَ كَفَرُو[s[اْ] بِـَٔـايَ[n[ـٰ]تِنَا هُمْ أَصْحَ[n[ـٰ]بُ [h:13211[ٱ]لْمَشْــَٔمَةِ"}, {"n": 20, "t": "عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ", "p": 594, "tj": "عَلَيْهِمْ نَا[a:14520[رٌ م]ُّؤْصَدَةُۢ"}]}