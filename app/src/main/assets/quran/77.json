{"ayahs": [{"n": 1, "t": "وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا"}, {"n": 2, "t": "فَٱلۡعَٰصِفَٰتِ عَصۡفٗا"}, {"n": 3, "t": "وَٱلنَّـٰشِرَٰتِ نَشۡرٗا"}, {"n": 4, "t": "فَٱلۡفَٰرِقَٰتِ فَرۡقٗا"}, {"n": 5, "t": "فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا"}, {"n": 6, "t": "عُذۡرًا أَوۡ نُذۡرًا"}, {"n": 7, "t": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ"}, {"n": 8, "t": "فَإِذَا ٱلنُّجُومُ طُمِسَتۡ"}, {"n": 9, "t": "وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ"}, {"n": 10, "t": "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ"}, {"n": 11, "t": "وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ"}, {"n": 12, "t": "لِأَيِّ يَوۡمٍ أُجِّلَتۡ"}, {"n": 13, "t": "لِيَوۡمِ ٱلۡفَصۡلِ"}, {"n": 14, "t": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ"}, {"n": 15, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"}, {"n": 16, "t": "أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ"}, {"n": 17, "t": "ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ"}, {"n": 18, "t": "كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ"}, {"n": 19, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"}, {"n": 20, "t": "أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ"}, {"n": 21, "t": "فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ"}, {"n": 22, "t": "إِلَىٰ قَدَرٖ مَّعۡلُومٖ"}, {"n": 23, "t": "فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ"}, {"n": 24, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"}, {"n": 25, "t": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا"}, {"n": 26, "t": "أَحۡيَآءٗ وَأَمۡوَٰتٗا"}, {"n": 27, "t": "وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا"}, {"n": 28, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"}, {"n": 29, "t": "ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"}, {"n": 30, "t": "ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ"}, {"n": 31, "t": "لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ"}, {"n": 32, "t": "إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ"}, {"n": 33, "t": "كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ"}, {"n": 34, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"}, {"n": 35, "t": "هَٰذَا يَوۡمُ لَا يَنطِقُونَ"}, {"n": 36, "t": "وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ"}, {"n": 37, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"}, {"n": 38, "t": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ"}, {"n": 39, "t": "فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ"}, {"n": 40, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"}, {"n": 41, "t": "إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ"}, {"n": 42, "t": "وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ"}, {"n": 43, "t": "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ"}, {"n": 44, "t": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"}, {"n": 45, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"}, {"n": 46, "t": "كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ"}, {"n": 47, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"}, {"n": 48, "t": "وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ"}, {"n": 49, "t": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"}, {"n": 50, "t": "فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ"}]}