<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ variant of backup_rules.xml — same reasoning: exclude the rebuildable database
     caches so the small, irreplaceable user data always fits the backup quota. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
