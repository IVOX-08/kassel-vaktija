    <string name="onb_welcome_title">Mirë se vini</string>
    <string name="onb_welcome_body">Aplikacioni i bashkësisë IGBD Sanxhak-Kassel — kohët e namazit, Kur\'ani, hadithet dhe më shumë, në gjuhën tuaj.</string>
    <string name="onb_notif_title">Namazi dhe Ezani</string>
    <string name="onb_notif_body">Kohë të sakta të namazit me njoftime. Për çdo namaz zgjidhni ezanin ose një tingull të shkurtër dhe rregulloni njoftimet — të gjitha te Cilësimet.</string>
    <string name="onb_content_title">Kur\'ani, Hadithi dhe Dhikri</string>
    <string name="onb_content_body">I gjithë Kur\'ani në arabisht, 40 hadithet e Neveviut dhe një përzgjedhje nga Rijad us-Salihin, si dhe dhikri — në arabisht dhe në gjuhën tuaj.</string>
    <string name="onb_more_title">Dhe më shumë</string>
    <string name="onb_more_body">Kibla, kalendari, lajmet e bashkësisë dhe një vegël për ekranin kryesor. Allahu e pranoftë.</string>
    <string name="onb_start">Fillo</string>
    <string name="onb_perms_title">Lejet</string>
    <string name="onb_perms_body">Që aplikacioni t\'ju kujtojë namazin dhe njoftimet në kohë, ju lutemi lejoni sa vijon.</string>
    <string name="onb_allow">Lejo</string>
    <string name="onb_next">Vazhdo</string>
