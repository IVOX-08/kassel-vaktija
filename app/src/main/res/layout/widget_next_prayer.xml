<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_emblem"
        android:contentDescription="@string/cd_app_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFE0A93A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#A6000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="5" />

        <Chronometer
            android:id="@+id/widget_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:shadowColor="#BF000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/widget_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:shadowColor="#BF000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="5" />
    </LinearLayout>
</LinearLayout>
