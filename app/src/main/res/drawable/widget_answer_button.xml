<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the tracker's Yes/No buttons on the home-screen widget.
  Translucent white over the widget's dark crest artwork, so both buttons stay legible whatever
  wallpaper sits behind them.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
    <corners android:radius="14dp" />
</shape>
