    <!-- Onboarding -->
    <string name="onb_welcome_title">Dobro došli</string>
    <string name="onb_welcome_body">Aplikacija zajednice IGBD Sandžak-Kassel — namaska vremena, Kur\'an, hadisi i još mnogo toga, na vašem jeziku.</string>
    <string name="onb_notif_title">Namaz i ezan</string>
    <string name="onb_notif_body">Tačna namaska vremena uz obavijesti. Za svaki namaz birajte ezan ili kratki zvuk i podesite obavijesti — sve u Postavkama.</string>
    <string name="onb_content_title">Kur\'an, hadis i zikr</string>
    <string name="onb_content_body">Cijeli Kur\'an na arapskom, Nevevijevih 40 hadisa i izbor iz Rijadus-salihina te zbirka zikrova — na arapskom i vašem jeziku.</string>
    <string name="onb_more_title">I još više</string>
    <string name="onb_more_body">Kibla, kalendar, vijesti zajednice i widget za početni ekran. Neka vam Allah primi.</string>
    <string name="onb_start">Započni</string>
    <string name="onb_perms_title">Dozvole</string>
    <string name="onb_perms_body">Da bi vas aplikacija na vrijeme obavijestila o namazu i vijestima, omogućite sljedeće dozvole.</string>
    <string name="onb_allow">Dozvoli</string>
    <string name="onb_next">Dalje</string>
    <string name="onb_skip">Preskoči</string>
    <string name="onb_finish">Gotovo</string>
    <string name="onb_perm_notif_title">Obavijesti</string>
    <string name="onb_perm_notif_body">Želiš li podsjetnike na namaska vremena (ezan) i obavijesti zajednice? Aplikaciji je potrebna dozvola za slanje obavijesti.</string>
    <string name="onb_perm_dnd_title">„Ne uznemiravaj“</string>
    <string name="onb_perm_dnd_body">Da bi se ezan čuo i kada je telefon na nečujnom, dozvoli pristup opciji „Ne uznemiravaj“.</string>
    <string name="onb_perm_widget_title">Widget</string>
    <string name="onb_perm_widget_body">Želiš li vidjeti sljedeće namasko vrijeme direktno na početnom ekranu? Dodaj widget jednim dodirom.</string>
    <string name="onb_perm_widget_action">Dodaj na početni ekran</string>
    <string name="onb_perm_widget_unsupported">Tvoj početni ekran ne podržava automatsko dodavanje. Widget možeš dodati ručno: dugo pritisni početni ekran → Widgeti → „Kassel Vaktija“.</string>

