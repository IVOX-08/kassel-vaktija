    <string name="onb_welcome_title">Welcome</string>
    <string name="onb_welcome_body">The app of the IGBD Sandžak-Kassel community — prayer times, Qur\'an, hadith and more, in your language.</string>
    <string name="onb_notif_title">Prayer &amp; Adhan</string>
    <string name="onb_notif_body">Accurate prayer times with notifications. For each prayer choose the Adhan or a short tone and adjust alerts — all in Settings.</string>
    <string name="onb_content_title">Qur\'an, Hadith &amp; Dhikr</string>
    <string name="onb_content_body">The full Qur\'an in Arabic, an-Nawawi\'s 40 hadith and a selection from Riyad as-Salihin, plus dhikr — in Arabic and your language.</string>
    <string name="onb_more_title">And more</string>
    <string name="onb_more_body">Qibla, calendar, community news and a home-screen widget. May Allah accept it.</string>
    <string name="onb_start">Get started</string>
    <string name="onb_perms_title">Permissions</string>
    <string name="onb_perms_body">So the app can remind you of prayers and announcements on time, please allow the following.</string>
    <string name="onb_allow">Allow</string>
    <string name="onb_next">Next</string>
    <string name="onb_skip">Skip</string>
    <string name="onb_finish">Done</string>
    <string name="onb_perm_notif_title">Notifications</string>
    <string name="onb_perm_notif_body">Want to be reminded of prayer times (Adhan) and community announcements? The app needs permission to send notifications.</string>
    <string name="onb_perm_dnd_title">Do Not Disturb</string>
    <string name="onb_perm_dnd_body">So the Adhan can still be heard when your phone is on silent, allow Do-Not-Disturb access.</string>
    <string name="onb_perm_widget_title">Widget</string>
    <string name="onb_perm_widget_body">Want to see the next prayer time right on your home screen? Add the widget with one tap.</string>
    <string name="onb_perm_widget_action">Add to home screen</string>
    <string name="onb_perm_widget_unsupported">Your home screen doesn\'t support adding it automatically. You can add the widget manually: long-press the home screen → Widgets → \"Kassel Vaktija\".</string>

