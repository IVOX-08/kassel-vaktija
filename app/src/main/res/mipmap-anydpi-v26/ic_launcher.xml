<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon: the IGBD mark on white. The app serves eighty-one communities, so it
     carries the federation's mark rather than any single community's coat of arms. Foreground PNGs
     are generated by tools/gen_launcher_icon.py into mipmap-<density>/ic_launcher_foreground.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
