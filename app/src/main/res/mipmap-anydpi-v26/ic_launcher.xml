<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon: the crest of IGBD-Gemeinde Sandzak-Kassel e. V. on white.
     NOT the federation mark. Google Play rejected that on 7 Sept 2026 under the impersonation
     policy, and no signed permission from the federation exists to appeal with. This crest is
     the association's own and Play carried it for months before the August rebrand.
     Foreground PNGs live in mipmap-<density>/ic_launcher_foreground.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
