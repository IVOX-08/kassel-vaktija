    <string name="onb_perm_notif_title">Bildirimler</string>
    <string name="onb_perm_notif_body">Namaz vakitleri (ezan) ve cemaatten gelen duyurular için hatırlatma almak ister misin? Bunun için uygulamanın bildirim gönderme iznine ihtiyacı var.</string>
    <string name="onb_perm_dnd_title">\"Rahatsız etmeyin\"</string>
    <string name="onb_perm_dnd_body">Telefonun sessizdeyken bile ezanın duyulabilmesi için \"Rahatsız etmeyin\" erişimine izin ver.</string>
    <string name="onb_perm_widget_title">Widget</string>
    <string name="onb_perm_widget_body">Bir sonraki namaz vaktini doğrudan ana ekranında görmek ister misin? Widget\'ı tek dokunuşla ekle.</string>
