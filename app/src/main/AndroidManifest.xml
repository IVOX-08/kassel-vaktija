<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network: the vaktija.eu data source. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Prayer-time alarms & Adhan playback (Phase 3). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Exact alarms are a core feature of a prayer-times app, so USE_EXACT_ALARM (auto-granted on
         Android 13+) is justified; SCHEDULE_EXACT_ALARM covers Android 12. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Qibla while travelling. COARSE only, foreground only, never sent anywhere: the bearing to
         the Kaaba shifts by far less than a degree over a kilometre, so a city-level fix is as good
         as a precise one — and it keeps this to a permission people grant without hesitating. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Auto-silence during prayer: toggle Do Not Disturb (Phase 4). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- TV support is optional: the app must install on phones AND TVs. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".KasselVaktijaApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.KasselVaktija"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode|locale|layoutDirection|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.KasselVaktija"
            android:windowSoftInputMode="adjustResize">

            <!-- Phone / default launcher entry -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV / Fire TV launcher entry -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Persists the user-selected app language across restarts (AppCompat per-app language). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- We provide WorkManager's configuration ourselves (Configuration.Provider in the
             Application), so disable the default automatic initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Plays the Adhan when a prayer time arrives. -->
        <service
            android:name=".service.audio.AdhanForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Receives instant announcement pushes (Firebase Cloud Messaging). -->
        <service
            android:name=".service.notification.PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Channel used for FCM notifications shown by the system while the app is backgrounded. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="news_announcements_v2" />

        <!-- Fired by AlarmManager at each scheduled prayer/pre-warning. -->
        <receiver
            android:name=".service.alarm.PrayerAlarmReceiver"
            android:exported="false" />

        <!-- Home-screen prayer-times widget (Glance). -->
        <receiver
            android:name=".service.widget.PrayerTimesWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_widget_info" />
        </receiver>

        <!-- Re-arms alarms after boot / app update / time/timezone/locale changes. -->
        <receiver
            android:name=".service.alarm.RescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <!-- Android 12: re-arm as EXACT alarms the moment the user grants the permission. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
